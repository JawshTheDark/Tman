<Window x:Class="Tman.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Tman.Controls"
        Title="Tman" Width="1280" Height="820" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}" FontFamily="{StaticResource UiFont}" FontSize="12"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Background="{StaticResource SidebarBrush}" Padding="4,0">
            <MenuItem Header="_File">
                <MenuItem Header="_Run new task" InputGestureText="Ctrl+N" Click="RunTask_Click" />
                <MenuItem x:Name="AdminItem" Header="Restart as _administrator" Click="Admin_Click" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Refresh now" InputGestureText="F5" Click="Refresh_Click" />
                <MenuItem Header="_Update speed">
                    <MenuItem x:Name="SpeedHigh" Header="_High (0.5 s)" Tag="500" IsCheckable="True" Click="Speed_Click" />
                    <MenuItem x:Name="SpeedNormal" Header="_Normal (1 s)" Tag="1000" IsCheckable="True" Click="Speed_Click" />
                    <MenuItem x:Name="SpeedLow" Header="_Low (4 s)" Tag="4000" IsCheckable="True" Click="Speed_Click" />
                    <MenuItem x:Name="SpeedPaused" Header="_Paused" Tag="0" IsCheckable="True" Click="Speed_Click" />
                </MenuItem>
                <Separator />
                <MenuItem x:Name="TopmostItem" Header="Always on _top" IsCheckable="True" Click="Topmost_Click" />
                <MenuItem x:Name="CollapseItem" Header="_Compact sidebar" IsCheckable="True" Click="Collapse_Click" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About Tman" Click="About_Click" />
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavColumn" Width="224" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource SidebarBrush}" BorderBrush="#18202A" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,14,0,8">
                        <c:LogoMark Width="30" Height="30" />
                        <StackPanel x:Name="BrandText" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Tman" FontSize="18" FontWeight="Bold" Foreground="#F2F5F8" />
                            <TextBlock Text="SYSTEM MONITOR" FontSize="9" FontWeight="Bold" Foreground="{StaticResource LabelBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" Padding="0,4"
                             ItemContainerStyle="{StaticResource NavItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="Nav_SelectionChanged" />
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource ContentBrush}">
                <ContentControl x:Name="Host" Margin="24,16,24,12" Focusable="False" />
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource SidebarBrush}" BorderBrush="#18202A" BorderThickness="0,1,0,0" Padding="12,4">
            <DockPanel TextElement.FontSize="11">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Border x:Name="RecBadge" Cursor="Hand" Background="Transparent" Padding="6,0" MouseLeftButtonUp="Rec_Click"
                            ToolTip="Flight recorder: the last hour of activity is kept in memory. Click to open it.">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="RecDot" Width="7" Height="7" Fill="#FF4D4D" VerticalAlignment="Center" />
                            <TextBlock x:Name="RecText" Text="REC" Margin="6,0,0,0" FontWeight="Bold" Foreground="#FF8A8A" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="AdminBadge" Margin="14,0,0,0" Style="{StaticResource Subtle}" VerticalAlignment="Center" />
                    <TextBlock x:Name="ClockText" Margin="16,0,0,0" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="LiveDot" Width="7" Height="7" Fill="{StaticResource GoodBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="LiveText" Margin="6,0,18,0" FontWeight="Bold" Foreground="{StaticResource GoodBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusProcs" Style="{StaticResource Subtle}" Margin="0,0,18,0" VerticalAlignment="Center" />
                    <TextBlock Text="CPU" FontWeight="Bold" Foreground="{StaticResource CpuBrush}" VerticalAlignment="Center" />
                    <c:LedBar x:Name="StatusCpuBar" Orientation="Horizontal" Width="64" Height="8" Segment="3" Gap="1" UseScale="True" Margin="6,0,6,0" />
                    <TextBlock x:Name="StatusCpu" Style="{StaticResource Subtle}" Margin="0,0,18,0" VerticalAlignment="Center" />
                    <TextBlock Text="MEM" FontWeight="Bold" Foreground="{StaticResource MemBrush}" VerticalAlignment="Center" />
                    <c:LedBar x:Name="StatusMemBar" Orientation="Horizontal" Width="64" Height="8" Segment="3" Gap="1" Fill="{StaticResource MemBrush}" Margin="6,0,6,0" />
                    <TextBlock x:Name="StatusMem" Style="{StaticResource Subtle}" Margin="0,0,18,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusUptime" Style="{StaticResource Subtle}" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
