<UserControl x:Class="Tman.Pages.DiskSpacePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Tman.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Analyze a folder…" Click="PickFolder_Click" VerticalAlignment="Center" />
            <TextBlock Text="Disk space" Style="{StaticResource PageTitle}" />
        </DockPanel>

        <ItemsControl x:Name="Drives" Grid.Row="1" Margin="0,14,0,4" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Width="270" Margin="0,0,12,12" Padding="14,12">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Analyze" Tag="{Binding Root}" Click="AnalyzeDrive_Click" Padding="10,3" />
                                <TextBlock Text="&#xEDA2;" Style="{StaticResource Glyph}" FontSize="20" Margin="0,0,10,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Format}" Style="{StaticResource Subtle}" FontSize="12" />
                                </StackPanel>
                            </DockPanel>
                            <c:UsageBar Value="{Binding Fraction}" Fill="{Binding Brush}" Margin="0,12,0,6" />
                            <TextBlock Text="{Binding Text}" Style="{StaticResource Subtle}" FontSize="12" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <DockPanel Grid.Row="2" Margin="0,4,0,8">
            <Button x:Name="UpButton" DockPanel.Dock="Left" IsEnabled="False" Click="Up_Click" Padding="10,5" Margin="0,0,10,0" ToolTip="Up one level">
                <TextBlock Text="&#xE74A;" Style="{StaticResource Glyph}" FontSize="14" />
            </Button>
            <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel" Visibility="Collapsed" Click="Cancel_Click" />
            <TextBlock x:Name="ProgressText" DockPanel.Dock="Right" Style="{StaticResource Subtle}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBlock x:Name="PathText" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                       Text="Pick a drive or folder to see what's using the space." />
        </DockPanel>

        <DataGrid x:Name="List" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  MouseDoubleClick="List_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Name" SortMemberPath="Name" Width="*" MinWidth="240">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <DockPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="14" Margin="0,0,10,0" Foreground="{StaticResource NetBrush}" />
                                <TextBlock Text="{Binding Name}" Style="{StaticResource CellText}" />
                            </DockPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Size" Width="100" ElementStyle="{StaticResource NumText}" />
                <DataGridTemplateColumn Header="% of folder" SortMemberPath="Fraction" Width="190">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid VerticalAlignment="Center" Margin="0,0,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="52" />
                                </Grid.ColumnDefinitions>
                                <c:UsageBar Value="{Binding Fraction}" Fill="{StaticResource NetBrush}" Height="6" />
                                <TextBlock Grid.Column="1" Text="{Binding PercentText}" TextAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Files" Binding="{Binding FilesText}" SortMemberPath="Files" Width="100" ElementStyle="{StaticResource NumText}" />
                <DataGridTextColumn Header="Folders" Binding="{Binding FoldersText}" SortMemberPath="Folders" Width="100" ElementStyle="{StaticResource NumText}" />
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Open" Click="Open_Click" />
                    <MenuItem Header="Show in File Explorer" Click="ShowInExplorer_Click" />
                    <MenuItem Header="Copy path" Click="CopyPath_Click" />
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
    </Grid>
</UserControl>
