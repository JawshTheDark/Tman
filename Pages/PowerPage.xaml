<UserControl x:Class="Tman.Pages.PowerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Tman.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
        <StackPanel>
            <TextBlock Text="Power &amp; frequency" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="Subtitle" Margin="0,2,0,16" Style="{StaticResource Subtle}" TextTrimming="CharacterEllipsis" />

            <UniformGrid x:Name="Tiles" Columns="4">
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="Average clock" Style="{StaticResource StatLabel}" />
                        <TextBlock x:Name="ClockValue" Text="—" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource CpuBrush}" />
                        <TextBlock x:Name="ClockSub" FontSize="12" Style="{StaticResource Subtle}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="CPU package power" Style="{StaticResource StatLabel}" />
                        <TextBlock x:Name="PowerValue" Text="—" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource PowerBrush}" />
                        <TextBlock x:Name="PowerSub" FontSize="12" Style="{StaticResource Subtle}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="Throttling" Style="{StaticResource StatLabel}" />
                        <TextBlock x:Name="LimitValue" Text="—" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock x:Name="LimitSub" FontSize="12" Style="{StaticResource Subtle}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="Parked processors" Style="{StaticResource StatLabel}" />
                        <TextBlock x:Name="ParkedValue" Text="—" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock x:Name="ParkedSub" FontSize="12" Style="{StaticResource Subtle}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <c:NeonPanel x:Name="ClockPanel" Header="Clock speed" Accent="{StaticResource CpuBrush}" Margin="0,0,14,14">
                    <StackPanel>
                        <c:LineGraph x:Name="ClockGraph" Height="130" Stroke="{StaticResource CpuBrush}" />
                        <TextBlock Text="Solid: average of all processors · dashed: fastest processor" FontSize="11" Margin="0,6,0,0" Style="{StaticResource Subtle}" />
                    </StackPanel>
                </c:NeonPanel>
                <c:NeonPanel x:Name="PowerGraphCard" Grid.Column="1" Header="CPU power" Accent="{StaticResource PowerBrush}" Margin="0,0,12,14">
                    <StackPanel>
                        <c:LineGraph x:Name="PowerGraph" Height="130" Stroke="{StaticResource PowerBrush}" />
                        <TextBlock x:Name="PowerLegend" Text="Solid: whole package · dashed: cores only" FontSize="11" Margin="0,6,0,0" Style="{StaticResource Subtle}" />
                    </StackPanel>
                </c:NeonPanel>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                <StackPanel>
                    <DockPanel>
                        <TextBlock x:Name="CoresNote" DockPanel.Dock="Right" FontSize="12" VerticalAlignment="Center" Style="{StaticResource Subtle}" />
                        <TextBlock Text="Logical processors" Style="{StaticResource CardTitle}" />
                    </DockPanel>
                    <UniformGrid x:Name="CoreGrid" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="Power plan" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                        <ComboBox x:Name="PlanBox" MinWidth="280" HorizontalAlignment="Left" SelectionChanged="PlanBox_SelectionChanged" />
                        <StackPanel x:Name="ModePanel" Margin="0,14,0,0">
                            <TextBlock Text="Power mode" Style="{StaticResource StatLabel}" Margin="0,0,0,4" />
                            <ComboBox x:Name="ModeBox" MinWidth="280" HorizontalAlignment="Left" SelectionChanged="ModeBox_SelectionChanged" />
                            <TextBlock x:Name="ModeNote" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" Style="{StaticResource Subtle}" />
                        </StackPanel>
                        <TextBlock x:Name="PolicyText" Margin="0,14,0,0" LineHeight="22" TextWrapping="Wrap" />
                        <Button Content="Power options" Margin="0,12,0,0" HorizontalAlignment="Left" Click="PowerOptions_Click" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock x:Name="MeterNote" DockPanel.Dock="Right" FontSize="12" VerticalAlignment="Center" Style="{StaticResource Subtle}" />
                            <TextBlock Text="Power meter" Style="{StaticResource CardTitle}" />
                        </DockPanel>
                        <StackPanel x:Name="Channels" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
