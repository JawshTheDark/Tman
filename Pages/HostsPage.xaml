<UserControl x:Class="Tman.Pages.HostsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Tman.Controls">
    <UserControl.Resources>
        <Style x:Key="EnabledCell" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Enabled}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource SubtleBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WarningCell" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
            <Setter Property="ToolTip" Value="{Binding Warning}" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="ToolTip" Value="{x:Null}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition MinHeight="120" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Hosts file" Style="{StaticResource PageTitle}" />
        <TextBlock Grid.Row="1" Style="{StaticResource PageSubtitle}"
                   Text="Windows checks this file before DNS, so an entry here decides where a name goes." />
        <c:AdminNote Grid.Row="2" Text="Saving needs administrator rights. You can read everything here without them." />
        <Border x:Name="WarnBox" Grid.Row="3" Style="{StaticResource SlimCard}" BorderBrush="{StaticResource WarnBrush}" Margin="0,10,0,0" Visibility="Collapsed">
            <TextBlock x:Name="WarnText" TextWrapping="Wrap" />
        </Border>
        <WrapPanel Grid.Row="4" Style="{StaticResource ActionRow}" Margin="0,12,0,2">
            <Button x:Name="AddButton" Content="Add" Margin="0,0,8,8" Click="Add_Click" />
            <Button x:Name="EditButton" Content="Edit" Margin="0,0,8,8" Click="Edit_Click" />
            <Button x:Name="RemoveButton" Content="Remove" Margin="0,0,8,8" Click="Remove_Click" />
            <Button x:Name="EnableButton" Content="Enable" Margin="0,0,8,8" Click="Enable_Click" />
            <Button x:Name="DisableButton" Content="Disable" Margin="0,0,16,8" Click="Disable_Click" />
            <Button x:Name="SaveButton" Content="Save" Margin="0,0,8,8" Click="Save_Click" />
            <Button x:Name="ReloadButton" Content="Reload" Margin="0,0,8,8" Click="Reload_Click" />
            <Button x:Name="RestoreButton" Content="Restore backup" Margin="0,0,8,8" Click="Restore_Click" />
        </WrapPanel>
        <TabControl x:Name="Tabs" Grid.Row="5">
            <TabItem Header="Entries">
                <Grid Margin="0,10,0,0">
                    <DataGrid x:Name="List" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"
                              SelectionChanged="List_SelectionChanged" MouseDoubleClick="List_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Enabled" Binding="{Binding EnabledText}" Width="74" MinWidth="74" ElementStyle="{StaticResource EnabledCell}" />
                            <DataGridTextColumn Header="IP address" Binding="{Binding Ip}" Width="150" MinWidth="110" ElementStyle="{StaticResource EnabledCell}" />
                            <DataGridTextColumn Header="Host name" Binding="{Binding Hosts}" Width="*" MinWidth="180" ElementStyle="{StaticResource EnabledCell}" />
                            <DataGridTextColumn Header="Comment" Binding="{Binding Comment}" Width="*" MinWidth="120" ElementStyle="{StaticResource EnabledCell}" />
                            <DataGridTextColumn Header="Warning" Binding="{Binding Warning}" Width="260" MinWidth="130" ElementStyle="{StaticResource WarningCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="EmptyText" Style="{StaticResource EmptyText}" Visibility="Collapsed" />
                </Grid>
            </TabItem>
            <TabItem x:Name="RawTab" Header="Raw text">
                <TextBox x:Name="RawBox" Margin="0,10,0,0" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                         VerticalContentAlignment="Top" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
            </TabItem>
        </TabControl>
        <TextBlock x:Name="StatusText" Grid.Row="6" Margin="0,8,0,0" Style="{StaticResource Subtle}" TextWrapping="Wrap" />
    </Grid>
</UserControl>
