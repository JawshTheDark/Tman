<UserControl x:Class="Tman.Pages.EventLogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Tman.Controls">
    <UserControl.Resources>
        <GroupStyle x:Key="BySource">
            <GroupStyle.ContainerStyle>
                <Style TargetType="GroupItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="GroupItem">
                                <Expander>
                                    <Expander.Header>
                                        <TextBlock TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text="{Binding ItemCount, Mode=OneWay, StringFormat='· {0:#,0}'}" Foreground="{StaticResource SubtleBrush}" />
                                        </TextBlock>
                                    </Expander.Header>
                                    <ItemsPresenter />
                                </Expander>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </GroupStyle.ContainerStyle>
        </GroupStyle>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="ListRow" />
            <RowDefinition x:Name="DetailRow" Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Event log" Style="{StaticResource PageTitle}" />
        <c:AdminNote x:Name="AdminStrip" Grid.Row="1"
                     Text="The Security log and many smaller logs can only be read as administrator." />
        <!-- Two rows of one toolbar: what to look in, then how to narrow it -->
        <StackPanel Grid.Row="2" Style="{StaticResource Toolbar}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Refresh" Margin="8,0,0,0" Click="Refresh_Click" />
                <Button DockPanel.Dock="Right" Content="Open Event Viewer" Margin="8,0,0,0" Click="OpenViewer_Click" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="170" MaxWidth="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <c:SearchBox x:Name="Search" Placeholder="Search source, event ID or message" />
                    <ComboBox x:Name="LogBox" Grid.Column="1" Margin="10,0,0,0" MinWidth="120" SelectionChanged="Query_Changed" />
                </Grid>
            </DockPanel>
            <WrapPanel Margin="0,8,0,0">
                <ComboBox x:Name="RangeBox" MinWidth="130" VerticalAlignment="Center" SelectedIndex="2" SelectionChanged="Query_Changed">
                    <ComboBoxItem Content="Last hour" />
                    <ComboBoxItem Content="Last 24 hours" />
                    <ComboBoxItem Content="Last 7 days" />
                    <ComboBoxItem Content="Last 30 days" />
                    <ComboBoxItem Content="All time" />
                </ComboBox>
                <CheckBox x:Name="CriticalBox" Content="Critical" MinWidth="0" Margin="14,0,0,0" VerticalAlignment="Center" IsChecked="True" Click="Query_Changed" />
                <CheckBox x:Name="ErrorBox" Content="Error" MinWidth="0" Margin="14,0,0,0" VerticalAlignment="Center" IsChecked="True" Click="Query_Changed" />
                <CheckBox x:Name="WarningBox" Content="Warning" MinWidth="0" Margin="14,0,0,0" VerticalAlignment="Center" IsChecked="True" Click="Query_Changed" />
                <CheckBox x:Name="InfoBox" Content="Information" MinWidth="0" Margin="14,0,0,0" VerticalAlignment="Center" IsChecked="True" Click="Query_Changed" />
                <CheckBox x:Name="GroupBox" Content="Group by source" MinWidth="0" Margin="14,0,0,0" VerticalAlignment="Center" Click="Group_Click" />
                <TextBlock x:Name="CountText" Style="{StaticResource ToolbarCount}" />
            </WrapPanel>
            <TextBlock x:Name="NoteText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}" Visibility="Collapsed" />
        </StackPanel>
        <DataGrid x:Name="List" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  VirtualizingPanel.IsVirtualizingWhenGrouping="True" SelectionChanged="List_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Level" SortMemberPath="Level" Width="85">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding LevelText}" Foreground="{Binding LevelBrush}" Style="{StaticResource CellText}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Date and time" Binding="{Binding TimeText}" SortMemberPath="Time" Width="138" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="124" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Event ID" Binding="{Binding Id}" Width="80" ElementStyle="{StaticResource NumText}" />
                <DataGridTextColumn Header="Message" Binding="{Binding Summary}" Width="*" MinWidth="100" ElementStyle="{StaticResource CellText}" />
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Search online" Click="SearchOnline_Click" />
                    <MenuItem Header="Copy details" Click="Copy_Click" />
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
        <TextBlock x:Name="EmptyText" Grid.Row="3" Visibility="Collapsed" Style="{StaticResource EmptyText}" />
        <Border x:Name="DetailsPane" Grid.Row="4" Style="{StaticResource SlimCard}" Margin="0,10,0,0" Visibility="Collapsed">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <Button DockPanel.Dock="Right" Content="Copy details" Margin="8,0,0,0" Click="Copy_Click" />
                    <Button DockPanel.Dock="Right" Content="Search online" Margin="8,0,0,0" Click="SearchOnline_Click" />
                    <StackPanel>
                        <TextBlock x:Name="DetailTitle" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="DetailSub" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Style="{StaticResource Subtle}" />
                    </StackPanel>
                </DockPanel>
                <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="DetailMessage" TextWrapping="Wrap" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
