<UserControl x:Class="Tman.Pages.EventLogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Tman.Controls">
    <UserControl.Resources>
        <GroupStyle x:Key="BySource">
            <GroupStyle.ContainerStyle>
                <Style TargetType="GroupItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="GroupItem">
                                <Expander>
                                    <Expander.Header>
                                        <TextBlock TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text="{Binding ItemCount, Mode=OneWay, StringFormat='· {0:#,0}'}" Foreground="{StaticResource SubtleBrush}" />
                                        </TextBlock>
                                    </Expander.Header>
                                    <ItemsPresenter />
                                </Expander>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </GroupStyle.ContainerStyle>
        </GroupStyle>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="ListRow" />
            <RowDefinition x:Name="DetailRow" Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel>
            <TextBlock x:Name="CountText" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Bottom" Style="{StaticResource Subtle}" />
            <TextBlock Text="Event log" Style="{StaticResource PageTitle}" />
        </DockPanel>
        <c:AdminNote x:Name="AdminStrip" Grid.Row="1" Margin="0,10,0,0"
                     Text="The Security log and many smaller logs can only be read as administrator." />
        <DockPanel Grid.Row="2" Margin="0,12,0,8">
            <Button DockPanel.Dock="Right" Content="Refresh" Margin="8,0,0,0" Click="Refresh_Click" />
            <Button DockPanel.Dock="Right" Content="Open Event Viewer" Margin="8,0,0,0" Click="OpenViewer_Click" />
            <ComboBox x:Name="RangeBox" DockPanel.Dock="Right" Margin="8,0,0,0" MinWidth="130" SelectedIndex="2" SelectionChanged="Query_Changed">
                <ComboBoxItem Content="Last hour" />
                <ComboBoxItem Content="Last 24 hours" />
                <ComboBoxItem Content="Last 7 days" />
                <ComboBoxItem Content="Last 30 days" />
                <ComboBoxItem Content="All time" />
            </ComboBox>
            <ComboBox x:Name="LogBox" MinWidth="120" SelectionChanged="Query_Changed" />
        </DockPanel>
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="170" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <c:SearchBox x:Name="Search" Placeholder="Search source, event ID or message" VerticalAlignment="Center" />
            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                <CheckBox x:Name="CriticalBox" Content="Critical" MinWidth="0" Margin="10,0,0,0" IsChecked="True" Click="Query_Changed" />
                <CheckBox x:Name="ErrorBox" Content="Error" MinWidth="0" Margin="10,0,0,0" IsChecked="True" Click="Query_Changed" />
                <CheckBox x:Name="WarningBox" Content="Warning" MinWidth="0" Margin="10,0,0,0" IsChecked="True" Click="Query_Changed" />
                <CheckBox x:Name="InfoBox" Content="Information" MinWidth="0" Margin="10,0,0,0" IsChecked="True" Click="Query_Changed" />
                <CheckBox x:Name="GroupBox" Content="Group by source" MinWidth="0" Margin="10,0,0,0" Click="Group_Click" />
            </WrapPanel>
        </Grid>
        <TextBlock x:Name="NoteText" Grid.Row="4" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}" Visibility="Collapsed" />
        <DataGrid x:Name="List" Grid.Row="5" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  VirtualizingPanel.IsVirtualizingWhenGrouping="True" SelectionChanged="List_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Level" SortMemberPath="Level" Width="85">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding LevelText}" Foreground="{Binding LevelBrush}" Style="{StaticResource CellText}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Date and time" Binding="{Binding TimeText}" SortMemberPath="Time" Width="138" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="124" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Event ID" Binding="{Binding Id}" Width="80" ElementStyle="{StaticResource NumText}" />
                <DataGridTextColumn Header="Message" Binding="{Binding Summary}" Width="*" MinWidth="100" ElementStyle="{StaticResource CellText}" />
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Search online" Click="SearchOnline_Click" />
                    <MenuItem Header="Copy details" Click="Copy_Click" />
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
        <TextBlock x:Name="EmptyText" Grid.Row="5" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                   TextWrapping="Wrap" Visibility="Collapsed" Style="{StaticResource Subtle}" />
        <Border x:Name="DetailsPane" Grid.Row="6" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="14,10" Visibility="Collapsed">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <Button DockPanel.Dock="Right" Content="Copy details" Margin="8,0,0,0" Click="Copy_Click" />
                    <Button DockPanel.Dock="Right" Content="Search online" Click="SearchOnline_Click" />
                    <StackPanel>
                        <TextBlock x:Name="DetailTitle" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="DetailSub" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Style="{StaticResource Subtle}" />
                    </StackPanel>
                </DockPanel>
                <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="DetailMessage" TextWrapping="Wrap" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
