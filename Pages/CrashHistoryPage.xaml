<UserControl x:Class="Tman.Pages.CrashHistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Tman.Controls">
    <UserControl.Resources>
        <Style x:Key="TileLabel" TargetType="TextBlock" BasedOn="{StaticResource StatLabel}">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Tile" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Crash history" Style="{StaticResource PageTitle}" />
        <StackPanel x:Name="HeadPanel" Grid.Row="1" Margin="0,8,0,10">
            <TextBlock x:Name="Headline" Text="Reading the event logs…" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="SubHeadline" Margin="0,2,0,0" TextWrapping="Wrap" Style="{StaticResource Subtle}" />
            <TextBlock x:Name="TopLine" Visibility="Collapsed" TextTrimming="CharacterEllipsis" Style="{StaticResource Subtle}" />
        </StackPanel>
        <TextBlock x:Name="CountLine" Grid.Row="2" Margin="0,0,0,8" Visibility="Collapsed" TextTrimming="CharacterEllipsis" />
        <UniformGrid x:Name="Tiles" Grid.Row="2" Columns="4" Margin="0,0,-10,10">
            <Border Style="{StaticResource Tile}">
                <StackPanel>
                    <TextBlock Text="Blue screens" Style="{StaticResource TileLabel}" />
                    <TextBlock x:Name="BlueCount" Text="—" Style="{StaticResource StatValue}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}">
                <StackPanel>
                    <TextBlock Text="Unexpected shutdowns" Style="{StaticResource TileLabel}" />
                    <TextBlock x:Name="ShutdownCount" Text="—" Style="{StaticResource StatValue}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}">
                <StackPanel>
                    <TextBlock Text="App crashes" Style="{StaticResource TileLabel}" />
                    <TextBlock x:Name="CrashCount" Text="—" Style="{StaticResource StatValue}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}">
                <StackPanel>
                    <TextBlock Text="App hangs" Style="{StaticResource TileLabel}" />
                    <TextBlock x:Name="HangCount" Text="—" Style="{StaticResource StatValue}" />
                </StackPanel>
            </Border>
        </UniformGrid>
        <DockPanel Grid.Row="3" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="Refresh" Margin="8,0,0,0" Click="Refresh_Click" />
            <ComboBox x:Name="KindBox" MinWidth="170" SelectedIndex="0" SelectionChanged="KindBox_SelectionChanged">
                <ComboBoxItem Content="Everything" />
                <ComboBoxItem Content="Blue screens" />
                <ComboBoxItem Content="Unexpected shutdowns" />
                <ComboBoxItem Content="App crashes" />
                <ComboBoxItem Content="App hangs" />
            </ComboBox>
            <ComboBox x:Name="RangeBox" Margin="8,0,0,0" MinWidth="125" SelectedIndex="1" SelectionChanged="RangeBox_SelectionChanged">
                <ComboBoxItem Content="Last 7 days" />
                <ComboBoxItem Content="Last 30 days" />
                <ComboBoxItem Content="Last 90 days" />
                <ComboBoxItem Content="All time" />
            </ComboBox>
            <c:SearchBox x:Name="Search" Margin="8,0,0,0" MinWidth="100" Placeholder="Search" />
        </DockPanel>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition x:Name="SideColumn" Width="250" />
            </Grid.ColumnDefinitions>
            <DataGrid x:Name="List" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="List_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="When" Binding="{Binding TimeText}" SortMemberPath="Time" Width="135" ElementStyle="{StaticResource CellText}" />
                    <DataGridTemplateColumn Header="What happened" SortMemberPath="KindText" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding KindText}" Foreground="{Binding KindBrush}" Style="{StaticResource CellText}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Details" Binding="{Binding Summary}" Width="*" MinWidth="120" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="Times" Binding="{Binding Count}" Width="60" ElementStyle="{StaticResource NumText}" />
                </DataGrid.Columns>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Search online" Click="SearchOnline_Click" />
                        <MenuItem Header="Copy details" Click="Copy_Click" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>
            <TextBlock x:Name="EmptyText" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" Visibility="Collapsed" Style="{StaticResource Subtle}" />
            <Border x:Name="SidePane" Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0" Padding="14,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Top crashing apps" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                    <TextBlock x:Name="TopEmpty" DockPanel.Dock="Top" TextWrapping="Wrap" Style="{StaticResource Subtle}" Visibility="Collapsed" />
                    <ItemsControl x:Name="TopApps">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Total}" Margin="8,0,0,0" FontWeight="Bold" />
                                        <TextBlock Text="{Binding App}" TextTrimming="CharacterEllipsis" ToolTip="{Binding App}" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Breakdown}" FontSize="11" Style="{StaticResource Subtle}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </Grid>
        <Border x:Name="DetailsPane" Grid.Row="5" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="14,10" Visibility="Collapsed">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0">
                    <Button Content="Search online" HorizontalAlignment="Stretch" Click="SearchOnline_Click" />
                    <Button x:Name="OpenButton" Content="Open file location" HorizontalAlignment="Stretch" Margin="0,6,0,0" Click="OpenLocation_Click" />
                    <Button Content="Copy details" HorizontalAlignment="Stretch" Margin="0,6,0,0" Click="Copy_Click" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="DetailTitle" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                        <TextBlock x:Name="DetailWhen" Margin="0,2,0,0" TextWrapping="Wrap" Style="{StaticResource Subtle}" />
                        <TextBlock x:Name="DetailExplain" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <StackPanel x:Name="DetailFacts" Margin="0,8,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
