<UserControl x:Class="Tman.Pages.SharesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Tman.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition MinHeight="150" />
        </Grid.RowDefinitions>
        <TextBlock Text="Shared folders" Style="{StaticResource PageTitle}" />
        <c:AdminNote Grid.Row="1"
                     Text="Seeing who's connected and which files are open, stopping a share and closing a session all need administrator rights. Your shares are listed either way." />
        <DockPanel Grid.Row="2" Style="{StaticResource Toolbar}">
            <Button DockPanel.Dock="Right" Content="Refresh" Margin="8,0,0,0" VerticalAlignment="Center" Click="Refresh_Click" />
            <TextBlock x:Name="SharingText" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
        <TabControl Grid.Row="3">
            <TabItem Header="Shares">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition MinHeight="60" />
                    </Grid.RowDefinitions>
                    <WrapPanel Style="{StaticResource ActionRow}">
                        <Button x:Name="StopButton" Content="Stop sharing" Margin="0,0,8,8" IsEnabled="False" Click="Stop_Click" />
                        <Button x:Name="OpenButton" Content="Open folder" Margin="0,0,8,8" IsEnabled="False" Click="Open_Click" />
                        <TextBlock x:Name="ShareCount" Style="{StaticResource ToolbarCount}" Margin="4,0,0,8" />
                    </WrapPanel>
                    <Border x:Name="NoShares" Grid.Row="1" Style="{StaticResource SlimCard}" Margin="0,0,0,10" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="No folders are shared" Style="{StaticResource CardHeading}" />
                            <TextBlock x:Name="NoSharesText" Style="{StaticResource Subtle}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <DataGrid x:Name="Shares" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="Shares_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Share" Binding="{Binding Name}" Width="150" MinWidth="150" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="110" MinWidth="110" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Folder" Binding="{Binding Path}" Width="*" MinWidth="200" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="200" MinWidth="200" ElementStyle="{StaticResource CellText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="SharesEmpty" Grid.Row="2" Style="{StaticResource EmptyText}" Visibility="Collapsed" />
                </Grid>
            </TabItem>
            <TabItem Header="Sessions">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition MinHeight="60" />
                    </Grid.RowDefinitions>
                    <WrapPanel Style="{StaticResource ActionRow}">
                        <Button x:Name="CloseButton" Content="Close session" Margin="0,0,8,8" IsEnabled="False" Click="CloseSession_Click" />
                        <TextBlock x:Name="SessionCount" Style="{StaticResource ToolbarCount}" Margin="4,0,0,8" />
                    </WrapPanel>
                    <DataGrid x:Name="Sessions" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="Sessions_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Computer" Binding="{Binding Client}" Width="*" MinWidth="170" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="User" Binding="{Binding User}" Width="160" MinWidth="160" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Open files" Binding="{Binding OpenFiles}" Width="90" MinWidth="90" ElementStyle="{StaticResource NumText}" />
                            <DataGridTextColumn Header="Connected" Binding="{Binding ConnectedText}" SortMemberPath="Connected" Width="100" MinWidth="100" ElementStyle="{StaticResource NumText}" />
                            <DataGridTextColumn Header="Idle" Binding="{Binding IdleText}" SortMemberPath="Idle" Width="90" MinWidth="90" ElementStyle="{StaticResource NumText}" />
                            <DataGridTextColumn Header="Guest" Binding="{Binding GuestText}" Width="70" MinWidth="70" ElementStyle="{StaticResource CellText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="SessionsEmpty" Grid.Row="1" Style="{StaticResource EmptyText}" Visibility="Collapsed" />
                </Grid>
            </TabItem>
            <TabItem Header="Open files">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition MinHeight="60" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="FileCount" Style="{StaticResource ToolbarCount}" Margin="0,0,0,10" />
                    <DataGrid x:Name="Files" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="File" Binding="{Binding Path}" Width="*" MinWidth="240" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="User" Binding="{Binding User}" Width="150" MinWidth="150" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Access" Binding="{Binding Access}" Width="110" MinWidth="110" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Locks" Binding="{Binding Locks}" Width="70" MinWidth="70" ElementStyle="{StaticResource NumText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="FilesEmpty" Grid.Row="1" Style="{StaticResource EmptyText}" Visibility="Collapsed" />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
