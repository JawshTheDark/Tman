<UserControl x:Class="Tman.Pages.UsersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock Text="Users" Style="{StaticResource PageTitle}" />
        <DockPanel Grid.Row="1" Margin="0,12,0,10">
            <Button x:Name="SignOffButton" DockPanel.Dock="Right" Content="Sign off" Margin="8,0,0,0" IsEnabled="False" Click="SignOff_Click" />
            <Button x:Name="DisconnectButton" DockPanel.Dock="Right" Content="Disconnect" IsEnabled="False" Click="Disconnect_Click" />
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Style="{StaticResource Subtle}" />
        </DockPanel>
        <DataGrid x:Name="List" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  SelectionChanged="List_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="User" Binding="{Binding User}" Width="*" MinWidth="160" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Session" Binding="{Binding Station}" Width="120" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="ID" Binding="{Binding SessionId}" Width="60" ElementStyle="{StaticResource NumText}" />
                <DataGridTextColumn Header="Status" Binding="{Binding State}" Width="120" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Processes" Binding="{Binding Processes}" Width="100" ElementStyle="{StaticResource NumText}" />
                <DataGridTextColumn Header="CPU" Binding="{Binding CpuText}" SortMemberPath="Cpu" Width="90" ElementStyle="{StaticResource NumText}" />
                <DataGridTextColumn Header="Memory" Binding="{Binding MemoryText}" SortMemberPath="Memory" Width="120" ElementStyle="{StaticResource NumText}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
