<UserControl x:Class="Tman.Pages.ScheduledTasksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Tman.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition MinHeight="80" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="Scheduled tasks" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="CountText" Margin="12,0,0,3" VerticalAlignment="Bottom" TextAlignment="Right" TextTrimming="CharacterEllipsis" Style="{StaticResource Subtle}" />
        </DockPanel>
        <c:AdminNote Grid.Row="1" Margin="0,10,0,0"
                     Text="Some tasks that belong to Windows or other accounts stay hidden from a standard user. Running or changing them needs administrator rights. Your own tasks work as normal." />
        <Grid Grid.Row="2" Margin="0,12,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="170" MaxWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <c:SearchBox x:Name="Search" Margin="0,0,14,0" Placeholder="Search name, folder, author or action" />
            <CheckBox x:Name="ShowMicrosoft" Grid.Column="1" Content="Show Microsoft's tasks" MinWidth="0" Margin="0,0,14,0" VerticalAlignment="Center" Click="Filter_Click" />
            <CheckBox x:Name="FailedOnly" Grid.Column="2" Content="Failed last run" MinWidth="0" VerticalAlignment="Center" Click="Filter_Click" />
        </Grid>
        <WrapPanel Grid.Row="3" Margin="0,2,0,4">
            <Button x:Name="RunButton" Content="Run now" Margin="0,0,8,6" IsEnabled="False" Click="Run_Click" />
            <Button x:Name="EndButton" Content="End" Margin="0,0,8,6" IsEnabled="False" Click="End_Click" />
            <Button x:Name="EnableButton" Content="Enable" Margin="0,0,8,6" IsEnabled="False" Click="Enable_Click" />
            <Button x:Name="DisableButton" Content="Disable" Margin="0,0,8,6" IsEnabled="False" Click="Disable_Click" />
            <Button Content="Open Task Scheduler" Margin="0,0,8,6" Click="OpenScheduler_Click" />
            <Button Content="Refresh" Margin="0,0,8,6" Click="Refresh_Click" />
        </WrapPanel>
        <DataGrid x:Name="List" Grid.Row="4" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  SelectionChanged="List_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="210" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="130" MinWidth="130" ElementStyle="{StaticResource CellText}" />
                <DataGridTemplateColumn Header="State" SortMemberPath="State" Width="80" MinWidth="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding State}" Foreground="{Binding StateBrush}" Style="{StaticResource CellText}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Last run" Binding="{Binding LastRunText}" SortMemberPath="LastRun" Width="125" MinWidth="125" ElementStyle="{StaticResource CellText}" />
                <DataGridTemplateColumn Header="Last result" SortMemberPath="ResultText" Width="240" MinWidth="240">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ResultText}" ToolTip="{Binding ResultText}" Foreground="{Binding ResultBrush}" Style="{StaticResource CellText}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Next run" Binding="{Binding NextRunText}" SortMemberPath="NextRun" Width="125" MinWidth="125" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="130" MinWidth="130" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="240" MinWidth="240" ElementStyle="{StaticResource CellText}" />
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="RunMenu" Header="Run now" Click="Run_Click" />
                    <MenuItem x:Name="EndMenu" Header="End" Click="End_Click" />
                    <MenuItem x:Name="EnableMenu" Header="Enable" Click="Enable_Click" />
                    <MenuItem x:Name="DisableMenu" Header="Disable" Click="Disable_Click" />
                    <Separator />
                    <MenuItem Header="Search online" Click="SearchOnline_Click" />
                    <MenuItem Header="Copy action" Click="CopyAction_Click" />
                    <MenuItem Header="Copy task path" Click="CopyPath_Click" />
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
        <TextBlock x:Name="EmptyText" Grid.Row="4" Style="{StaticResource Subtle}" TextWrapping="Wrap" TextAlignment="Center" Margin="30,40,30,0"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" />
        <Border x:Name="DetailsPane" Grid.Row="5" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="14,10" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="DetailTitle" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DetailInfo" Style="{StaticResource Subtle}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="TRIGGERS" Style="{StaticResource PanelLabel}" Margin="0,8,0,2" />
                    <TextBlock x:Name="DetailTriggers" TextWrapping="Wrap" />
                    <TextBlock Text="ACTION" Style="{StaticResource PanelLabel}" Margin="0,8,0,2" />
                    <TextBlock x:Name="DetailAction" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
