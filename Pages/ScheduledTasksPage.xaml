<UserControl x:Class="Tman.Pages.ScheduledTasksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Tman.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition MinHeight="80" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Scheduled tasks" Style="{StaticResource PageTitle}" />
        <c:AdminNote Grid.Row="1"
                     Text="Some tasks that belong to Windows or other accounts stay hidden from a standard user. Running or changing them needs administrator rights. Your own tasks work as normal." />
        <!-- A crowded row: the search box gives way first, down to 170, and then the count trims. -->
        <Grid Grid.Row="2" Style="{StaticResource Toolbar}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="170" MaxWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <c:SearchBox x:Name="Search" Placeholder="Search name, folder, author or action" />
            <CheckBox x:Name="ShowMicrosoft" Grid.Column="1" Content="Show Microsoft's tasks" MinWidth="0" Margin="14,0,0,0" VerticalAlignment="Center" Click="Filter_Click" />
            <CheckBox x:Name="FailedOnly" Grid.Column="2" Content="Failed last run" MinWidth="0" Margin="14,0,0,0" VerticalAlignment="Center" Click="Filter_Click" />
            <Button Grid.Column="4" Content="Open Task Scheduler" Margin="8,0,0,0" Click="OpenScheduler_Click" />
            <Button Grid.Column="5" Content="Refresh" Margin="8,0,0,0" Click="Refresh_Click" />
        </Grid>
        <WrapPanel Grid.Row="3" Style="{StaticResource ActionRow}">
            <Button x:Name="RunButton" Content="Run now" Margin="0,0,8,8" IsEnabled="False" Click="Run_Click" />
            <Button x:Name="EndButton" Content="End" Margin="0,0,16,8" IsEnabled="False" Click="End_Click" />
            <Button x:Name="EnableButton" Content="Enable" Margin="0,0,8,8" IsEnabled="False" Click="Enable_Click" />
            <Button x:Name="DisableButton" Content="Disable" Margin="0,0,8,8" IsEnabled="False" Click="Disable_Click" />
            <!-- The count is long here, so it sits with the row buttons, where there is room for all of it. -->
            <TextBlock x:Name="CountText" Style="{StaticResource ToolbarCount}" Margin="8,0,0,8" />
        </WrapPanel>
        <DataGrid x:Name="List" Grid.Row="4" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  SelectionChanged="List_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="170" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="95" MinWidth="95" ElementStyle="{StaticResource CellText}" />
                <DataGridTemplateColumn Header="State" SortMemberPath="State" Width="75" MinWidth="75">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding State}" Foreground="{Binding StateBrush}" Style="{StaticResource CellText}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Last run" Binding="{Binding LastRunText}" SortMemberPath="LastRun" Width="125" MinWidth="125" ElementStyle="{StaticResource CellText}" />
                <DataGridTemplateColumn Header="Last result" SortMemberPath="ResultText" Width="190" MinWidth="190">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ResultText}" ToolTip="{Binding ResultText}" Foreground="{Binding ResultBrush}" Style="{StaticResource CellText}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Next run" Binding="{Binding NextRunText}" SortMemberPath="NextRun" Width="125" MinWidth="125" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="105" MinWidth="105" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="90" MinWidth="90" ElementStyle="{StaticResource CellText}" />
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="RunMenu" Header="Run now" Click="Run_Click" />
                    <MenuItem x:Name="EndMenu" Header="End" Click="End_Click" />
                    <MenuItem x:Name="EnableMenu" Header="Enable" Click="Enable_Click" />
                    <MenuItem x:Name="DisableMenu" Header="Disable" Click="Disable_Click" />
                    <Separator />
                    <MenuItem Header="Search online" Click="SearchOnline_Click" />
                    <MenuItem Header="Copy action" Click="CopyAction_Click" />
                    <MenuItem Header="Copy task path" Click="CopyPath_Click" />
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
        <TextBlock x:Name="EmptyText" Grid.Row="4" Style="{StaticResource EmptyText}" Visibility="Collapsed" />
        <Border x:Name="DetailsPane" Grid.Row="5" Style="{StaticResource SlimCard}" Margin="0,10,0,0" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="DetailTitle" Style="{StaticResource CardHeading}" FontSize="15" />
                    <TextBlock x:Name="DetailInfo" Style="{StaticResource Subtle}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="TRIGGERS" Style="{StaticResource PanelLabel}" Margin="0,8,0,2" />
                    <TextBlock x:Name="DetailTriggers" TextWrapping="Wrap" />
                    <TextBlock Text="ACTION" Style="{StaticResource PanelLabel}" Margin="0,8,0,2" />
                    <TextBlock x:Name="DetailAction" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
