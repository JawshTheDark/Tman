<UserControl x:Class="Tman.Pages.PerformancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Tman.Controls">
    <UserControl.Resources>
        <DataTemplate x:Key="DeviceTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <c:LineGraph Height="48" ShowGrid="False" Data="{Binding Data}" Data2="{Binding Data2}" Stroke="{Binding Brush}"
                             Maximum="{Binding Max}" Scale="{Binding Scale}" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource SubtleBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle2}" FontSize="12" Foreground="{StaticResource SubtleBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock Text="Performance" Style="{StaticResource PageTitle}" />

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="Devices" Background="Transparent" BorderThickness="0" Padding="0"
                     ItemContainerStyle="{StaticResource DeviceItem}" ItemTemplate="{StaticResource DeviceTemplate}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

            <Grid x:Name="Detail" Grid.Column="1" Margin="22,0,0,0" DataContext="{Binding SelectedItem, ElementName=Devices}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition MinHeight="120" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Model}" FontSize="15" Foreground="{StaticResource SubtleBrush}"
                               VerticalAlignment="Bottom" Margin="16,0,0,3" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <DockPanel Grid.Row="1" Margin="0,12,0,4">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding MaxLabel}" Style="{StaticResource StatLabel}" VerticalAlignment="Bottom" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,16,0"
                                Visibility="{Binding HasCores, Converter={StaticResource BoolToVis}}">
                        <RadioButton Content="Overall" IsChecked="{Binding ShowOverall}" MinWidth="0" Margin="0,0,12,0" />
                        <RadioButton Content="Logical processors" IsChecked="{Binding ShowCores}" MinWidth="0" />
                    </StackPanel>
                    <TextBlock Text="{Binding GraphLabel}" Style="{StaticResource StatLabel}" VerticalAlignment="Bottom" />
                </DockPanel>

                <Grid Grid.Row="2">
                    <c:LineGraph Data="{Binding Data}" Data2="{Binding Data2}" Stroke="{Binding Brush}" Maximum="{Binding Max}"
                                 Scale="{Binding Scale}" ShowScaleLabel="{Binding ShowScaleLabel}"
                                 Visibility="{Binding ShowOverall, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding Cores}" Visibility="{Binding ShowCores, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding CoreColumns}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <c:LineGraph Data="{Binding}" Stroke="{StaticResource CpuBrush}" ShowGrid="False" Margin="2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <ItemsControl Grid.Row="3" ItemsSource="{Binding Extras}" Margin="0,12,0,0" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding ExtraColumns}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,10,8">
                                <DockPanel Margin="0,0,0,3">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding MaxLabel}" Style="{StaticResource StatLabel}" />
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource StatLabel}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <c:LineGraph Height="{Binding Height}" Data="{Binding Data}" Data2="{Binding Data2}" Stroke="{Binding Brush}"
                                             Maximum="{Binding Max}" Scale="{Binding Scale}" ShowScaleLabel="{Binding ShowScaleLabel}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Grid.Row="4" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ItemsControl ItemsSource="{Binding Stats}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,30,14" MinWidth="96">
                                    <TextBlock Text="{Binding Key}" Style="{StaticResource StatLabel}" />
                                    <TextBlock Text="{Binding Value}" Style="{StaticResource StatValue}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Info}" Grid.IsSharedSizeScope="True" Margin="24,0,0,0" MaxWidth="420" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition SharedSizeGroup="InfoKey" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Key}" Style="{StaticResource StatLabel}" Margin="0,0,20,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
