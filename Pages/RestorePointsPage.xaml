<UserControl x:Class="Tman.Pages.RestorePointsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Tman.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock Text="Restore points" Style="{StaticResource PageTitle}" />
        <c:AdminNote Grid.Row="1" Text="Windows only lets administrators see the list of restore points or create one. Without admin, Tman can only show whether System Protection is on." />
        <Border Grid.Row="2" Style="{StaticResource SlimCard}" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="SYSTEM PROTECTION" Style="{StaticResource PanelLabel}" />
                    <TextBlock x:Name="ProtectionValue" Style="{StaticResource StatValue}" Margin="0,4,0,2" />
                    <TextBlock x:Name="ProtectionText" Style="{StaticResource Subtle}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="HOW OFTEN WINDOWS ALLOWS A NEW ONE" Style="{StaticResource PanelLabel}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="LimitValue" Style="{StaticResource StatValue}" Margin="0,4,0,2" />
                    <TextBlock x:Name="LimitText" Style="{StaticResource Subtle}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>
        <DockPanel Grid.Row="3" Style="{StaticResource Toolbar}">
            <Button DockPanel.Dock="Right" Content="Refresh" Margin="8,0,0,0" Click="Refresh_Click" />
            <Button x:Name="CreateButton" Content="Create restore point" Margin="0,0,8,0" IsEnabled="False" Click="Create_Click" />
            <Button Content="Open System Restore" Margin="0,0,8,0" Click="OpenRestore_Click" ToolTip="Windows asks for administrator permission to open this." />
            <Button Content="System Protection settings" Margin="0,0,8,0" Click="OpenSettings_Click" ToolTip="Windows asks for administrator permission to open this." />
            <TextBlock x:Name="StatusText" Style="{StaticResource Subtle}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="4,0,0,0" />
        </DockPanel>
        <Grid Grid.Row="4">
            <DataGrid x:Name="List" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding DateText}" SortMemberPath="Created" Width="170" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" MinWidth="160" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="150" ElementStyle="{StaticResource CellText}" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyText" Style="{StaticResource EmptyText}" Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
