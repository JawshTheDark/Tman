<UserControl x:Class="Tman.Pages.IsoBuilderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Tman.Controls"
             xmlns:p="clr-namespace:Tman.Pages">
    <UserControl.Resources>
        <DataTemplate x:Key="PickTemplate">
            <CheckBox IsChecked="{Binding Ticked}" ToolTip="{Binding Item.Note}" Margin="0,0,8,0">
                <TextBlock Text="{Binding Item.Title}" TextTrimming="CharacterEllipsis" />
            </CheckBox>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="PickPanel">
            <WrapPanel ItemWidth="196" />
        </ItemsPanelTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition MinHeight="110" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="PanelRow" Height="Auto" MaxHeight="260" />
        </Grid.RowDefinitions>
        <TextBlock Text="ISO builder" Style="{StaticResource PageTitle}" />
        <TextBlock Grid.Row="1" Margin="0,6,0,10" Style="{StaticResource Subtle}" TextWrapping="Wrap"
                   Text="Turns an official Windows 11 ISO into a smaller one with the apps you don't want taken out. Your original ISO isn't changed." />
        <c:AdminNote Grid.Row="2" Text="You can look inside an ISO, but building one and writing to USB need administrator rights, because Windows' image tools refuse to run without them." />
        <Border x:Name="LeftoverBar" Grid.Row="3" Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,10" Visibility="Collapsed"
                BorderBrush="{StaticResource WarnBrush}">
            <DockPanel>
                <Button x:Name="LeftoverButton" DockPanel.Dock="Right" Content="Clean up" Margin="12,0,0,0" Click="CleanUp_Click" />
                <TextBlock x:Name="LeftoverText" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="0,0,8,0">
                <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="WINDOWS ISO" Style="{StaticResource PanelLabel}" Margin="0,0,0,8" />
                        <DockPanel>
                            <Button x:Name="BrowseIsoButton" DockPanel.Dock="Right" Content="Choose ISO" Margin="8,0,0,0" Click="BrowseIso_Click" />
                            <TextBox x:Name="IsoBox" IsReadOnly="True" VerticalContentAlignment="Center" />
                        </DockPanel>
                        <TextBlock x:Name="IsoStatus" Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Use an ISO from Microsoft's Windows 11 download page. Tman won't download one for you. Running as administrator can hide mapped and mounted drives, so keep the ISO on a local drive." />
                        <DockPanel x:Name="EditionRow" Margin="0,8,0,0" Visibility="Collapsed">
                            <TextBlock Text="Edition" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ComboBox x:Name="Editions" DisplayMemberPath="Name" SelectionChanged="Option_Changed" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Button x:Name="ClearButton" DockPanel.Dock="Right" Content="Clear all" Margin="8,0,0,0" Click="Clear_Click" />
                            <Button x:Name="SuggestedButton" DockPanel.Dock="Right" Content="Suggested" Click="Suggested_Click"
                                    ToolTip="Ticks what most people can do without. Nothing that Windows itself depends on is ever offered." />
                            <TextBlock x:Name="RemoveCount" DockPanel.Dock="Right" Style="{StaticResource Subtle}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Text="REMOVE FROM THE IMAGE" Style="{StaticResource PanelLabel}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="Store apps" Style="{StaticResource StatLabel}" Margin="0,0,0,4" />
                        <ItemsControl x:Name="AppList" Focusable="False" ItemTemplate="{StaticResource PickTemplate}" ItemsPanel="{StaticResource PickPanel}" />
                        <TextBlock Text="Extras" Style="{StaticResource StatLabel}" Margin="0,10,0,4" />
                        <ItemsControl x:Name="ExtraList" Focusable="False" ItemTemplate="{StaticResource PickTemplate}" ItemsPanel="{StaticResource PickPanel}" />
                        <TextBlock Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="Anything an ISO doesn't include is skipped. Removed Store apps can be installed again from the Microsoft Store." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="SETUP" Style="{StaticResource PanelLabel}" Margin="0,0,0,8" />
                        <CheckBox x:Name="AnswerBox" Content="Skip the Microsoft account step" Checked="Option_Changed" Unchecked="Option_Changed" />
                        <TextBlock Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Text="Adds an answer file that creates this local administrator account instead, and skips the network screen. Setup still asks where to install, so no disk is wiped without you choosing it." />
                        <DockPanel x:Name="AccountRow" Margin="0,8,0,0" IsEnabled="False">
                            <TextBlock Text="Account name" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox x:Name="AccountBox" Text="User" MaxLength="20" Width="200" HorizontalAlignment="Left" VerticalContentAlignment="Center" TextChanged="Account_TextChanged" />
                        </DockPanel>
                        <TextBlock x:Name="AccountNote" Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="The account starts with no password, so anyone at the PC can sign in until you set one in Settings." />
                        <CheckBox x:Name="CleanBox" Content="Clean up the component store" IsChecked="True" Margin="0,10,0,0" />
                        <TextBlock Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Text="Makes the ISO smaller but can add 30 minutes or more to the build." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="OUTPUT" Style="{StaticResource PanelLabel}" Margin="0,0,0,8" />
                        <DockPanel>
                            <Button x:Name="BrowseOutputButton" DockPanel.Dock="Right" Content="Save as" Margin="8,0,0,0" Click="BrowseOutput_Click" />
                            <TextBox x:Name="OutputBox" IsReadOnly="True" VerticalContentAlignment="Center" />
                        </DockPanel>
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock Text="Work on" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ComboBox x:Name="WorkDrives" MinWidth="170" SelectionChanged="Option_Changed"
                                      ToolTip="Where the image is unpacked while it's edited. Only local NTFS drives work, and an SSD is much faster." />
                            <TextBlock x:Name="SpaceText" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" Style="{StaticResource Subtle}" />
                        </DockPanel>
                        <TextBlock x:Name="ToolText" Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="USB DRIVE" Style="{StaticResource PanelLabel}" Margin="0,0,0,8" />
                        <DockPanel>
                            <Button x:Name="BrowseUsbIsoButton" DockPanel.Dock="Right" Content="Choose ISO" Margin="8,0,0,0" Click="BrowseUsbIso_Click" />
                            <TextBox x:Name="UsbIsoBox" IsReadOnly="True" VerticalContentAlignment="Center" ToolTip="The ISO to write. A finished build fills this in." />
                        </DockPanel>
                        <DockPanel Margin="0,8,0,0">
                            <Button x:Name="WriteButton" DockPanel.Dock="Right" Content="Write to USB" Margin="8,0,0,0" IsEnabled="False" Click="Write_Click" />
                            <Button x:Name="RefreshUsbButton" DockPanel.Dock="Right" Content="Refresh" Margin="8,0,0,0" Click="RefreshUsb_Click" />
                            <ComboBox x:Name="UsbDisks" SelectionChanged="Option_Changed" />
                        </DockPanel>
                        <TextBlock x:Name="UsbStatus" Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="5" Margin="0,10,8,0">
            <Button x:Name="BuildButton" DockPanel.Dock="Left" Content="Build ISO" MinWidth="96" IsEnabled="False" Click="Build_Click" />
            <TextBlock x:Name="BuildStatus" Style="{StaticResource Subtle}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
        </DockPanel>
        <p:JobOutputPanel x:Name="Panel" Grid.Row="6" Margin="0,10,0,0" Visibility="Collapsed" />
    </Grid>
</UserControl>
