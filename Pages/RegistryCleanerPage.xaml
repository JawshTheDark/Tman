<UserControl x:Class="Tman.Pages.RegistryCleanerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Tman.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Registry cleaner" Style="{StaticResource PageTitle}" />
        <TextBlock Grid.Row="1" Style="{StaticResource PageSubtitle}"
                   Text="Finds leftover entries that point to a program whose file is gone, in a few well-defined places only. Nothing is ticked and nothing is removed until you choose it and confirm, and Tman saves a .reg backup first that one click puts back." />
        <c:AdminNote Grid.Row="2" Text="Entries under HKLM, shown with an Admin tag, need administrator rights to remove or restore. Entries under HKCU don't. Items on network or unavailable drives are left alone, not treated as missing." />

        <DockPanel Grid.Row="3" Style="{StaticResource Toolbar}">
            <Button x:Name="ScanButton" Content="Scan" Click="Scan_Click" />
            <Button x:Name="RemoveButton" Content="Remove selected" Margin="8,0,0,0" IsEnabled="False" Click="Remove_Click" />
            <Button x:Name="RestoreButton" Content="Restore last backup" Margin="8,0,0,0" IsEnabled="False" Click="Restore_Click"
                    ToolTip="Puts back everything removed in the most recent clean." />
            <TextBlock x:Name="CountText" Style="{StaticResource ToolbarCount}" />
        </DockPanel>

        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
            <Grid>
                <TextBlock x:Name="EmptyText" Style="{StaticResource EmptyText}" Visibility="Collapsed"
                           Text="Press Scan to look for broken entries. Nothing is changed by scanning." />
                <ItemsControl x:Name="List" Focusable="False" Margin="0,0,12,0">
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GroupItem">
                                                <StackPanel>
                                                    <ContentPresenter />
                                                    <ItemsPresenter />
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource PanelLabel}" Margin="0,8,0,6" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource SlimCard}" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding CanRemove}" ToolTip="{Binding LockReason}"
                                              VerticalAlignment="Center" MinWidth="0" Margin="0,0,10,0" Click="Check_Click" AutomationProperties.Name="{Binding Name}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource CardHeading}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Reason}" Style="{StaticResource Subtle}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Location}" Style="{StaticResource Subtle}" Margin="0,2,0,0" TextWrapping="Wrap" FontSize="11" Opacity="0.8" />
                                    </StackPanel>
                                    <ItemsControl Grid.Column="2" ItemsSource="{Binding Tags}" Focusable="False" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="1" CornerRadius="3" Padding="6,1" Margin="4,0,0,0">
                                                    <TextBlock Text="{Binding}" FontSize="10" Foreground="{StaticResource LabelBrush}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>

        <TextBlock x:Name="StatusText" Grid.Row="5" Style="{StaticResource Subtle}" Margin="0,8,0,0" TextWrapping="Wrap" MaxHeight="72" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
    </Grid>
</UserControl>
