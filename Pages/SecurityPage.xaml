<UserControl x:Class="Tman.Pages.SecurityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Tman.Controls">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="Refresh" Margin="8,0,0,0" Click="Refresh_Click" />
            <Button DockPanel.Dock="Right" Content="Open Windows Security" Click="OpenSecurity_Click" />
            <StackPanel>
                <TextBlock Text="Security" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="Summary" Style="{StaticResource Subtle}" Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>
        <c:AdminNote DockPanel.Dock="Top" Text="With administrator rights, BitLocker status is read from the drive itself. Without them, Tman shows what File Explorer reports." />
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <ItemsControl x:Name="Rows" Focusable="False">
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GroupItem">
                                            <StackPanel>
                                                <ContentPresenter />
                                                <ItemsPresenter />
                                            </StackPanel>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource PanelLabel}" Margin="0,10,0,6" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="82" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontWeight="Bold" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="{Binding Item.Name, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text=" " />
                                        <Run Text="{Binding Item.Value, Mode=OneWay}" Foreground="{Binding StateBrush}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Item.Meaning}" Style="{StaticResource Subtle}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="Open" Tag="{Binding Item.Open}" VerticalAlignment="Center" Visibility="{Binding OpenVisibility}" Click="Open_Click" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
