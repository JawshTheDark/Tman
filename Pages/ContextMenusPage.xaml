<UserControl x:Class="Tman.Pages.ContextMenusPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Tman.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition MinHeight="150" />
        </Grid.RowDefinitions>
        <TextBlock Text="Context menus" Style="{StaticResource PageTitle}" />
        <TextBlock Grid.Row="1" Margin="0,6,0,10" Style="{StaticResource Subtle}" TextWrapping="Wrap"
                   Text="Everything Explorer can add when you right-click. Hiding keeps the entry so you can bring it back, and Tman only deletes commands you added here. Windows 11 keeps most Command entries under Show more options, unless the classic menu tweak is on." />

        <WrapPanel Grid.Row="2" Margin="0,0,0,4">
            <Button x:Name="AddButton" Content="Add command" Margin="0,0,6,6" Click="Add_Click" />
            <Button x:Name="EditButton" Content="Edit" Margin="0,0,6,6" IsEnabled="False" Click="Edit_Click" />
            <Button x:Name="DeleteButton" Content="Delete" Margin="0,0,16,6" IsEnabled="False" Click="Delete_Click" />
            <Button x:Name="HideButton" Content="Hide" Margin="0,0,6,6" IsEnabled="False" Click="Hide_Click" />
            <Button x:Name="ShiftButton" Content="Show only with Shift" Margin="0,0,16,6" IsEnabled="False" Click="Shift_Click"
                    ToolTip="Keeps a command out of the everyday menu. Holding Shift while you right-click brings it back." />
            <Button Content="Refresh" Margin="0,0,0,6" Click="Refresh_Click" />
        </WrapPanel>

        <DockPanel Grid.Row="3" Margin="0,0,0,10">
            <c:SearchBox x:Name="Search" Width="240" Placeholder="Search entries" />
            <ComboBox x:Name="SourceFilter" Margin="10,0,0,0" MinWidth="150" SelectedIndex="0" SelectionChanged="Filter_SelectionChanged">
                <ComboBoxItem Content="All entries" />
                <ComboBoxItem Content="Added by apps" />
                <ComboBoxItem Content="Part of Windows" />
                <ComboBoxItem Content="Added here" />
                <ComboBoxItem Content="Hidden" />
            </ComboBox>
            <ComboBox x:Name="PlaceFilter" Margin="10,0,0,0" MinWidth="170" SelectedIndex="0" SelectionChanged="Filter_SelectionChanged">
                <ComboBoxItem Content="All locations" />
            </ComboBox>
            <TextBlock x:Name="CountText" Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource Subtle}" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <Border x:Name="PendingBar" Grid.Row="4" Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,10" Visibility="Collapsed"
                BorderBrush="{StaticResource AccentBrush}">
            <DockPanel>
                <Button x:Name="ExplorerButton" DockPanel.Dock="Right" Content="Restart Explorer" Margin="12,0,0,0" Click="RestartExplorer_Click" />
                <TextBlock Text="Some changes appear after Explorer restarts." TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <DataGrid x:Name="Entries" Grid.Row="5" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="Entries_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="230" MinWidth="230" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="State" Binding="{Binding StateText}" Width="115" MinWidth="115" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Shows on" Binding="{Binding PlacesText}" Width="170" MinWidth="170" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="From" Binding="{Binding From}" Width="140" MinWidth="140" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Type" Binding="{Binding KindText}" Width="105" MinWidth="105" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Runs" Binding="{Binding Detail}" Width="*" MinWidth="220" ElementStyle="{StaticResource CellText}" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="EmptyText" Grid.Row="5" Style="{StaticResource Subtle}" TextWrapping="Wrap" TextAlignment="Center" Margin="30,60,30,0"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" />
    </Grid>
</UserControl>
