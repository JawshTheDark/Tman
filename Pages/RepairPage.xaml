<UserControl x:Class="Tman.Pages.RepairPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Tman.Controls"
             xmlns:p="clr-namespace:Tman.Pages">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="5*" />
            <RowDefinition Height="4*" />
        </Grid.RowDefinitions>
        <TextBlock Text="System repair" Style="{StaticResource PageTitle}" />
        <c:AdminNote Grid.Row="1" Text="Every job here needs administrator rights, including the read-only image check: Windows' repair tools refuse to run without them." />
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,16,4,16" Margin="0,12,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <ItemsControl x:Name="Jobs" Focusable="False" Margin="0,0,12,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Content="{Binding Label}" Tag="{Binding}" MinWidth="76" Margin="8,0,0,0" VerticalAlignment="Center"
                                        IsEnabled="{Binding CanRun}" Click="Run_Click" />
                                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Drives}" SelectedItem="{Binding Drive}" MinWidth="90"
                                          VerticalAlignment="Center" Margin="10,0,0,0" ToolTip="Drive to scan. Only NTFS drives support this scan."
                                          Visibility="{Binding Job.NeedsDrive, Converter={StaticResource BoolToVis}}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Job.Title}" Style="{StaticResource CardHeading}" />
                                    <TextBlock Text="{Binding Job.Summary}" Style="{StaticResource Subtle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <p:JobOutputPanel x:Name="Panel" Grid.Row="3" Margin="0,10,0,0" />
    </Grid>
</UserControl>
