<UserControl x:Class="Tman.Pages.LeakMonitorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Tman.Controls">
    <UserControl.Resources>
        <DataTemplate x:Key="VerdictCell">
            <TextBlock Text="{Binding VerdictText}" Foreground="{Binding VerdictBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0" />
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition MinHeight="160" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Leak monitor" Style="{StaticResource PageTitle}" />

        <Border Grid.Row="1" Style="{StaticResource SlimCard}" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock x:Name="Headline" Style="{StaticResource CardHeading}" TextWrapping="Wrap" />
                <TextBlock x:Name="Detail" Style="{StaticResource Subtle}" Margin="0,2,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="ScanText" Foreground="{StaticResource LabelBrush}" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="2" Style="{StaticResource Toolbar}">
            <Button DockPanel.Dock="Right" Content="Refresh" Margin="8,0,0,0" Click="Refresh_Click" />
            <Button x:Name="OpenLogButton" DockPanel.Dock="Right" Content="Open log" Margin="8,0,0,0" Click="OpenLog_Click"
                    ToolTip="Opens the text file of past scans." />
            <Button x:Name="ScanButton" DockPanel.Dock="Right" Content="Scan" Margin="8,0,0,0" Click="Scan_Click"
                    ToolTip="Runs every leak check once and adds the results to a text file. Takes about 10 seconds." />
            <Button DockPanel.Dock="Right" Content="Export" Margin="8,0,0,0" Click="Export_Click" />
            <Button DockPanel.Dock="Right" Content="Start over" Margin="8,0,0,0" Click="Reset_Click"
                    ToolTip="Forgets the history and starts watching from now, such as after closing a suspect app." />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="170" MaxWidth="300" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <c:SearchBox x:Name="Search" Placeholder="Search" />
                <ComboBox x:Name="Period" Grid.Column="1" Margin="10,0,0,0" MinWidth="130" SelectedIndex="0" SelectionChanged="Period_SelectionChanged">
                    <ComboBoxItem Content="All history" />
                    <ComboBoxItem Content="Last 24 hours" Tag="24" />
                    <ComboBoxItem Content="Last 6 hours" Tag="6" />
                    <ComboBoxItem Content="Last hour" Tag="1" />
                </ComboBox>
                <TextBlock x:Name="Summary" Grid.Column="2" Style="{StaticResource ToolbarCount}" />
            </Grid>
        </DockPanel>

        <TabControl x:Name="Tabs" Grid.Row="3" SelectionChanged="Tabs_SelectionChanged">
            <TabItem Header="Apps">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition MinHeight="60" />
                    </Grid.RowDefinitions>
                    <CheckBox x:Name="ByProcess" Content="Show each process separately" MinWidth="0" Margin="0,0,0,10" Click="ByProcess_Click"
                              ToolTip="Normally every copy of an app is added together, because apps like browsers split across many processes." />
                    <DataGrid x:Name="AppsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="Grid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Verdict" Width="120" MinWidth="120" CellTemplate="{StaticResource VerdictCell}" SortMemberPath="Rank" />
                            <DataGridTextColumn Header="App" Binding="{Binding Name}" Width="*" MinWidth="170" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Copies or PID" Binding="{Binding Id}" Width="105" MinWidth="105" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Memory" Binding="{Binding NowText}" SortMemberPath="Now" Width="90" MinWidth="90" ElementStyle="{StaticResource NumText}" />
                            <DataGridTextColumn Header="Growth" Binding="{Binding GrowthText}" SortMemberPath="Growth" Width="90" MinWidth="90" ElementStyle="{StaticResource NumText}" />
                            <DataGridTextColumn Header="Per hour" Binding="{Binding RateText}" SortMemberPath="Rate" Width="90" MinWidth="90" ElementStyle="{StaticResource NumText}" />
                            <DataGridTextColumn Header="Handles" Binding="{Binding HandlesText}" SortMemberPath="HandlesNow" Width="80" MinWidth="80" ElementStyle="{StaticResource NumText}" />
                            <DataGridTextColumn Header="Handle growth" Binding="{Binding HandleGrowthText}" SortMemberPath="HandleGrowth" Width="135" MinWidth="135" ElementStyle="{StaticResource NumText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="AppsEmpty" Grid.Row="1" Style="{StaticResource EmptyText}" Visibility="Collapsed" />
                </Grid>
            </TabItem>
            <TabItem Header="Kernel">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition MinHeight="60" />
                    </Grid.RowDefinitions>
                    <WrapPanel Style="{StaticResource ActionRow}">
                        <Button x:Name="FindDriverButton" Content="Find driver" Margin="0,0,8,8" IsEnabled="False" Click="FindDriver_Click"
                                ToolTip="Searches loaded drivers for this tag. A short tag can match by chance, so treat a hit as a lead." />
                        <TextBlock Text="Drivers and Windows label kernel memory with four-letter tags. A growing tag points at the driver that's leaking." Margin="4,0,0,8"
                                   VerticalAlignment="Center" Style="{StaticResource Subtle}" TextWrapping="Wrap" />
                    </WrapPanel>
                    <DataGrid x:Name="TagsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="Grid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Verdict" Width="120" MinWidth="120" CellTemplate="{StaticResource VerdictCell}" SortMemberPath="Rank" />
                            <DataGridTextColumn Header="Tag" Binding="{Binding Name}" Width="70" MinWidth="70" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Pool" Binding="{Binding Id}" Width="80" MinWidth="80" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Used for" Binding="{Binding Detail}" Width="*" MinWidth="200" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Size" Binding="{Binding NowText}" SortMemberPath="Now" Width="90" MinWidth="90" ElementStyle="{StaticResource NumText}" />
                            <DataGridTextColumn Header="Growth" Binding="{Binding GrowthText}" SortMemberPath="Growth" Width="90" MinWidth="90" ElementStyle="{StaticResource NumText}" />
                            <DataGridTextColumn Header="Per hour" Binding="{Binding RateText}" SortMemberPath="Rate" Width="90" MinWidth="90" ElementStyle="{StaticResource NumText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="TagsEmpty" Grid.Row="1" Style="{StaticResource EmptyText}" Visibility="Collapsed" />
                </Grid>
            </TabItem>
            <TabItem Header="Zombie processes">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition MinHeight="60" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource SlimCard}">
                        <DockPanel>
                            <Button x:Name="TestButton" DockPanel.Dock="Right" Content="Test process exits" VerticalAlignment="Center" Margin="12,0,0,0" Click="TestExits_Click"
                                    ToolTip="Starts 25 harmless processes that exit at once, and checks whether they leave memory." />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="ZombieTitle" Style="{StaticResource CardHeading}" TextWrapping="Wrap" />
                                <TextBlock x:Name="ZombieText" Style="{StaticResource Subtle}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="MOST PROCESS HANDLES HELD" Style="{StaticResource PanelLabel}" Margin="0,0,0,8" />
                            <DataGrid x:Name="HoldersGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="App" Binding="{Binding Name}" Width="*" MinWidth="130" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="65" MinWidth="65" ElementStyle="{StaticResource NumText}" />
                                    <DataGridTextColumn Header="Process handles" Binding="{Binding ProcessHandles, StringFormat=N0}" Width="150" MinWidth="150" ElementStyle="{StaticResource NumText}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                        <DockPanel Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top" Text="DRIVERS NOT FROM MICROSOFT" Style="{StaticResource PanelLabel}" Margin="0,0,0,8" />
                            <DataGrid x:Name="DriversGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Driver" Binding="{Binding File}" Width="170" MinWidth="170" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Look here first because" Binding="{Binding Why}" Width="*" MinWidth="150" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Company" Binding="{Binding Company}" Width="130" MinWidth="130" ElementStyle="{StaticResource CellText}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <c:NeonPanel Grid.Row="4" Header="Trend" Accent="{StaticResource MemBrush}" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock x:Name="ChartTitle" Style="{StaticResource CardHeading}" />
                <TextBlock x:Name="ChartWhy" Style="{StaticResource Subtle}" Margin="0,2,0,6" TextWrapping="Wrap" />
                <c:TrendChart x:Name="Chart" Height="110" Stroke="{StaticResource MemBrush}" />
            </StackPanel>
        </c:NeonPanel>
    </Grid>
</UserControl>
