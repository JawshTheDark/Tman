<UserControl x:Class="Tman.Pages.AccountsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Tman.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition MinHeight="150" />
        </Grid.RowDefinitions>
        <TextBlock Text="Accounts" Style="{StaticResource PageTitle}" />
        <c:AdminNote Grid.Row="1"
                     Text="Enabling or disabling an account and changing who is an administrator need administrator rights. You can still see the accounts and groups below." />
        <DockPanel Grid.Row="2" Style="{StaticResource Toolbar}">
            <Button DockPanel.Dock="Right" Content="Refresh" Margin="8,0,0,0" Click="Refresh_Click" />
            <Button DockPanel.Dock="Right" Content="Open Local Users and Groups" Margin="8,0,0,0" Click="OpenLocalUsers_Click" />
            <Button DockPanel.Dock="Right" Content="Open User Accounts" Margin="8,0,0,0" Click="OpenUserAccounts_Click" />
            <TextBlock x:Name="CountText" Style="{StaticResource ToolbarCount}" Margin="0" />
        </DockPanel>
        <TabControl Grid.Row="3">
            <TabItem Header="Users">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition MinHeight="60" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <WrapPanel Style="{StaticResource ActionRow}">
                        <Button x:Name="EnableButton" Content="Enable" Margin="0,0,8,8" IsEnabled="False" Click="Enable_Click" />
                        <Button x:Name="DisableButton" Content="Disable" Margin="0,0,8,8" IsEnabled="False" Click="Disable_Click" />
                        <Button x:Name="AddAdminButton" Content="Add to Administrators" Margin="0,0,8,8" IsEnabled="False" Click="AddAdmin_Click" />
                        <Button x:Name="RemoveAdminButton" Content="Remove from Administrators" Margin="0,0,8,8" IsEnabled="False" Click="RemoveAdmin_Click" />
                    </WrapPanel>
                    <DataGrid x:Name="Users" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="Users_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Account" Binding="{Binding DisplayName}" SortMemberPath="Name" Width="*" MinWidth="170" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Full name" Binding="{Binding FullName}" Width="150" MinWidth="150" ElementStyle="{StaticResource CellText}" />
                            <DataGridTemplateColumn Header="Enabled" SortMemberPath="EnabledText" Width="90" MinWidth="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding EnabledText}" Foreground="{Binding EnabledBrush}" Style="{StaticResource CellText}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Admin" Binding="{Binding AdminText}" Width="70" MinWidth="70" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Last sign-in" Binding="{Binding LastSignInText}" SortMemberPath="LastSignIn" Width="130" MinWidth="130" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Password required" Binding="{Binding PasswordText}" Width="160" MinWidth="160" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Groups" Binding="{Binding GroupsText}" Width="200" MinWidth="200" ElementStyle="{StaticResource CellText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="UsersEmpty" Grid.Row="1" Style="{StaticResource EmptyText}" Visibility="Collapsed" />
                    <Border x:Name="UserDetails" Grid.Row="2" Style="{StaticResource SlimCard}" Margin="0,10,0,0" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="UserTitle" Style="{StaticResource CardHeading}" FontSize="15" />
                                <TextBlock x:Name="UserGroups" Margin="0,4,0,0" TextWrapping="Wrap" />
                                <TextBlock x:Name="UserNote" Style="{StaticResource Subtle}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Groups">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition MinHeight="60" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition MinHeight="60" />
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="Groups" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="Groups_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Group" Binding="{Binding Name}" Width="200" MinWidth="200" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Members" Binding="{Binding MemberCount}" Width="80" MinWidth="80" ElementStyle="{StaticResource NumText}" />
                            <DataGridTextColumn Header="Description" Binding="{Binding Comment}" Width="*" MinWidth="240" ElementStyle="{StaticResource CellText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="GroupsEmpty" Style="{StaticResource EmptyText}" Visibility="Collapsed" />
                    <TextBlock x:Name="MembersTitle" Grid.Row="1" Text="MEMBERS" Style="{StaticResource PanelLabel}" Margin="0,10,0,8" />
                    <DataGrid x:Name="Members" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Member" Binding="{Binding Name}" Width="*" MinWidth="240" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="130" MinWidth="130" ElementStyle="{StaticResource CellText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="MembersEmpty" Grid.Row="2" Style="{StaticResource EmptyText}" Text="Pick a group to see who's in it." />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
