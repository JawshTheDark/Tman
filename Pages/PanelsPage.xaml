<UserControl x:Class="Tman.Pages.PanelsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Tman.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Groups" Margin="0,0,12,0">
            <TextBlock Text="Control panels" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Classic Windows tools that are hard to find now. Some ask for administrator permission as they open. That prompt comes from Windows, not Tman." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
