<UserControl x:Class="Tman.Pages.DriversPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Tman.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock Text="Drivers" Style="{StaticResource PageTitle}" />
        <DockPanel Grid.Row="1" Margin="0,12,0,10">
            <Button DockPanel.Dock="Right" Content="Refresh" Margin="8,0,0,0" Click="Refresh_Click" />
            <Button DockPanel.Dock="Right" Content="Device Manager" Click="DeviceManager_Click" />
            <c:SearchBox x:Name="Search" Width="300" Placeholder="Search device, class or provider" />
            <CheckBox x:Name="HideMicrosoft" Content="Hide Microsoft drivers" Margin="14,0,0,0" Click="HideMicrosoft_Click" />
            <TextBlock x:Name="CountText" Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource Subtle}" />
        </DockPanel>
        <DataGrid x:Name="List" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Device" Binding="{Binding Device}" Width="*" MinWidth="240" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Class" Binding="{Binding Class}" Width="120" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="160" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="140" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Date" Binding="{Binding DateText}" SortMemberPath="Date" Width="100" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Signed" Binding="{Binding SignedText}" Width="70" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="INF" Binding="{Binding Inf}" Width="110" ElementStyle="{StaticResource CellText}" />
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Search online" Click="SearchOnline_Click" />
                    <MenuItem Header="Copy details" Click="Copy_Click" />
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
    </Grid>
</UserControl>
