<UserControl x:Class="Tman.Pages.BatteryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Tman.Controls">
    <UserControl.Resources>
        <!-- Label, value and a line of explanation, tinted by the stat's tone -->
        <DataTemplate x:Key="StatTemplate">
            <StackPanel Margin="0,0,12,12">
                <TextBlock Text="{Binding Label}" Style="{StaticResource StatLabel}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Value}" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource StatValue}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tone}" Value="Good">
                                    <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tone}" Value="Warn">
                                    <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tone}" Value="Bad">
                                    <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tone}" Value="Missing">
                                    <Setter Property="Foreground" Value="{StaticResource SubtleBrush}" />
                                    <Setter Property="FontSize" Value="13" />
                                    <Setter Property="FontWeight" Value="Normal" />
                                    <Setter Property="Margin" Value="0,3,0,3" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Note}" FontSize="11" Style="{StaticResource Subtle}" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="StatPanel">
            <WrapPanel ItemWidth="170" />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
        <StackPanel>
            <TextBlock Text="Battery" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="Subtitle" Style="{StaticResource PageSubtitle}" />

            <Border x:Name="NoBattery" Style="{StaticResource SlimCard}" Margin="0,12,0,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="This PC has no battery" Style="{StaticResource CardHeading}" />
                    <TextBlock Margin="0,2,0,0" Style="{StaticResource Subtle}" TextWrapping="Wrap"
                               Text="Windows doesn't see a battery, so there's nothing to show here. Most desktop PCs don't have one." />
                </StackPanel>
            </Border>

            <ItemsControl x:Name="Cards" Focusable="False" Style="{StaticResource PageBody}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <c:NeonPanel Header="{Binding Title}" Accent="{StaticResource PowerBrush}" Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding State}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="12,0,0,3" />
                                        <TextBlock Text="{Binding Charge}" FontSize="30" FontWeight="Bold" Foreground="{Binding ChargeBrush}" />
                                    </DockPanel>
                                    <c:UsageBar Value="{Binding ChargeFraction}" Fill="{Binding ChargeBrush}" Margin="0,6,0,14" />
                                    <ItemsControl ItemsSource="{Binding Live}" ItemTemplate="{StaticResource StatTemplate}" ItemsPanel="{StaticResource StatPanel}" Focusable="False" />
                                </StackPanel>
                            </c:NeonPanel>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="BATTERY HEALTH" Style="{StaticResource PanelLabel}" Margin="0,0,0,8" />
                                    <TextBlock Text="{Binding Verdict}" Foreground="{Binding VerdictBrush}" FontSize="22" FontWeight="Bold" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding VerdictText}" TextWrapping="Wrap" />
                                    <c:UsageBar Value="{Binding HeldFraction}" Fill="{Binding VerdictBrush}" Margin="0,10,0,14" />
                                    <ItemsControl ItemsSource="{Binding Capacity}" ItemTemplate="{StaticResource StatTemplate}" ItemsPanel="{StaticResource StatPanel}" Focusable="False" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
