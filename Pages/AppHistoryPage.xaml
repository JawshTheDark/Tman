<UserControl x:Class="Tman.Pages.AppHistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Tman.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock Text="App history" Style="{StaticResource PageTitle}" />
        <TextBlock x:Name="SinceText" Grid.Row="1" Margin="0,2,0,0" TextWrapping="Wrap" Style="{StaticResource Subtle}" />
        <DockPanel Grid.Row="2" Margin="0,12,0,10">
            <Button DockPanel.Dock="Right" Content="Delete usage history" Click="Clear_Click" />
            <c:SearchBox x:Name="Search" Width="300" Placeholder="Search apps" />
            <CheckBox x:Name="RunningOnly" Content="Running now" Margin="14,0,0,0" Click="RunningOnly_Click" />
            <TextBlock x:Name="CountText" Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource Subtle}" />
        </DockPanel>
        <DataGrid x:Name="List" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Name" SortMemberPath="Name" Width="*" MinWidth="220">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <DockPanel VerticalAlignment="Center">
                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="{Binding Name}" Style="{StaticResource CellText}" />
                            </DockPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Process" Binding="{Binding Exe}" Width="170" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="CPU time" Binding="{Binding CpuText}" SortMemberPath="CpuTime" Width="100" ElementStyle="{StaticResource NumText}" />
                <DataGridTextColumn Header="GPU time" Binding="{Binding GpuText}" SortMemberPath="GpuSeconds" Width="100" ElementStyle="{StaticResource NumText}" />
                <DataGridTextColumn Header="Disk I/O" Binding="{Binding IoText}" SortMemberPath="IoBytes" Width="100" ElementStyle="{StaticResource NumText}" />
                <DataGridTextColumn Header="Peak memory" Binding="{Binding PeakText}" SortMemberPath="PeakMemory" Width="115" ElementStyle="{StaticResource NumText}" />
                <DataGridTextColumn Header="Launches" Binding="{Binding Launches}" Width="90" ElementStyle="{StaticResource NumText}" />
                <DataGridTextColumn Header="Last used" Binding="{Binding LastText}" SortMemberPath="LastSeen" Width="120" ElementStyle="{StaticResource CellText}" />
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Open file location" Click="OpenLocation_Click" />
                    <MenuItem Header="Search online" Click="SearchOnline_Click" />
                    <MenuItem Header="Properties" Click="Properties_Click" />
                    <Separator />
                    <MenuItem Header="Copy" Click="Copy_Click" />
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
    </Grid>
</UserControl>
