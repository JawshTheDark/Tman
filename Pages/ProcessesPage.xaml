<UserControl x:Class="Tman.Pages.ProcessesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Tman.Controls">
    <UserControl.Resources>
        <Style x:Key="CpuCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Background" Value="{Binding CpuHeat}" />
        </Style>
        <Style x:Key="MemCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Background" Value="{Binding MemoryHeat}" />
        </Style>
        <Style x:Key="IoCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Background" Value="{Binding IoHeat}" />
        </Style>
        <Style x:Key="NetCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Background" Value="{Binding NetHeat}" />
        </Style>
        <Style x:Key="GpuCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Background" Value="{Binding GpuHeat}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Processes" Style="{StaticResource PageTitle}" />

        <DockPanel Grid.Row="1" Margin="0,12,0,10">
            <Button x:Name="EndButton" DockPanel.Dock="Right" Margin="8,0,0,0" IsEnabled="False" Click="End_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,8,0" />
                    <TextBlock Text="End task" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Click="Run_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,8,0" />
                    <TextBlock Text="Run new task" />
                </StackPanel>
            </Button>
            <c:SearchBox x:Name="Search" Width="320" Placeholder="Search by name, description, PID, user or signer" />
            <TextBlock x:Name="CountText" Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource Subtle}" />
        </DockPanel>

        <DataGrid x:Name="List" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"
                  SelectionChanged="Grid_SelectionChanged" MouseDoubleClick="Grid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Name" SortMemberPath="Name" Width="230" MinWidth="190">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <DockPanel VerticalAlignment="Center">
                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="{Binding Name}" Style="{StaticResource CellText}" />
                            </DockPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70" MinWidth="60" ElementStyle="{StaticResource NumText}" />
                <DataGridTemplateColumn Header="Status" SortMemberPath="Status" Width="104" MinWidth="104">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" Style="{StaticResource CellText}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="User" Binding="{Binding User}" Width="110" MinWidth="70" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="CPU" Binding="{Binding CpuText}" SortMemberPath="Cpu" Width="72" MinWidth="62"
                                    ElementStyle="{StaticResource NumText}" CellStyle="{StaticResource CpuCell}" />
                <DataGridTextColumn Header="Memory" Binding="{Binding MemoryText}" SortMemberPath="Memory" Width="100" MinWidth="88"
                                    ElementStyle="{StaticResource NumText}" CellStyle="{StaticResource MemCell}" />
                <DataGridTextColumn Header="I/O" Binding="{Binding IoText}" SortMemberPath="Io" Width="88" MinWidth="76"
                                    ElementStyle="{StaticResource NumText}" CellStyle="{StaticResource IoCell}" />
                <DataGridTextColumn x:Name="NetworkColumn" Header="Network" Binding="{Binding NetText}" SortMemberPath="Net" Width="92" MinWidth="84"
                                    ElementStyle="{StaticResource NumText}" CellStyle="{StaticResource NetCell}" />
                <DataGridTextColumn Header="GPU" Binding="{Binding GpuText}" SortMemberPath="Gpu" Width="70" MinWidth="60"
                                    ElementStyle="{StaticResource NumText}" CellStyle="{StaticResource GpuCell}" />
                <DataGridTextColumn Header="Threads" Binding="{Binding Threads}" Width="76" MinWidth="76" ElementStyle="{StaticResource NumText}" />
                <DataGridTextColumn Header="Handles" Binding="{Binding Handles}" Width="80" MinWidth="80" ElementStyle="{StaticResource NumText}" />
                <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="100" MinWidth="84" ElementStyle="{StaticResource CellText}" />
                <DataGridTemplateColumn x:Name="SignerColumn" Header="Signer" SortMemberPath="Signer" Width="170" MinWidth="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Signer}" Foreground="{Binding SignerBrush}" ToolTip="{Binding Signer}" Style="{StaticResource CellText}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" MinWidth="140" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Command line" Binding="{Binding CommandLine}" Width="300" MinWidth="140" ElementStyle="{StaticResource CellText}" />
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Details…" InputGestureText="Enter" FontWeight="Bold" Click="Details_Click" />
                    <MenuItem Header="Analyze wait chain" Click="WaitChain_Click" />
                    <Separator />
                    <MenuItem Header="End task" InputGestureText="Del" Click="End_Click" />
                    <MenuItem Header="End process tree" Click="EndTree_Click" />
                    <Separator />
                    <MenuItem Header="Suspend" Click="Suspend_Click" />
                    <MenuItem Header="Resume" Click="Resume_Click" />
                    <MenuItem Header="Set priority">
                        <MenuItem Header="Realtime" Tag="RealTime" Click="Priority_Click" />
                        <MenuItem Header="High" Tag="High" Click="Priority_Click" />
                        <MenuItem Header="Above normal" Tag="AboveNormal" Click="Priority_Click" />
                        <MenuItem Header="Normal" Tag="Normal" Click="Priority_Click" />
                        <MenuItem Header="Below normal" Tag="BelowNormal" Click="Priority_Click" />
                        <MenuItem Header="Low" Tag="Idle" Click="Priority_Click" />
                    </MenuItem>
                    <MenuItem Header="Set affinity…" Click="Affinity_Click" />
                    <Separator />
                    <MenuItem Header="Create memory dump…" Click="Dump_Click" />
                    <MenuItem Header="Open file location" Click="OpenLocation_Click" />
                    <MenuItem Header="Search online" Click="SearchOnline_Click" />
                    <MenuItem Header="Properties" Click="Properties_Click" />
                    <Separator />
                    <MenuItem Header="Copy">
                        <MenuItem Header="Name" Tag="name" Click="Copy_Click" />
                        <MenuItem Header="PID" Tag="pid" Click="Copy_Click" />
                        <MenuItem Header="Path" Tag="path" Click="Copy_Click" />
                        <MenuItem Header="Command line" Tag="cmd" Click="Copy_Click" />
                    </MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>

        <Border x:Name="DetailsPane" Grid.Row="3" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="14,10" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Image x:Name="DetailIcon" Width="32" Height="32" VerticalAlignment="Top" Margin="0,2,14,0" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Grid.Column="1">
                    <TextBlock>
                        <Run x:Name="DetailName" FontWeight="SemiBold" FontSize="15" />
                        <Run x:Name="DetailDesc" Foreground="{StaticResource SubtleBrush}" />
                    </TextBlock>
                    <TextBlock x:Name="DetailPath" Style="{StaticResource Subtle}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DetailCmd" Style="{StaticResource Subtle}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DetailMeta" Style="{StaticResource Subtle}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
