<UserControl x:Class="Tman.Pages.BenchmarksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="BigValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Text" Value="—" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition MinHeight="140" />
        </Grid.RowDefinitions>

        <TextBlock Text="Benchmarks" Style="{StaticResource PageTitle}" />
        <TextBlock Grid.Row="1" Margin="0,2,0,0" TextWrapping="Wrap" Style="{StaticResource Subtle}"
                   Text="Quick tests of this PC's processor, memory and drive. Close busy apps first for steadier numbers. CPU scores are relative: 1,000 is roughly one core of a Ryzen 9 7950X." />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,12">
            <Button x:Name="RunAllButton" Click="RunAll_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE768;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,8,0" />
                    <TextBlock Text="Run all" />
                </StackPanel>
            </Button>
            <Button x:Name="CancelButton" Content="Cancel" Margin="8,0,0,0" Visibility="Collapsed" Click="Cancel_Click" />
            <ProgressBar x:Name="Busy" Width="140" Height="4" IsIndeterminate="True" Margin="16,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Subtle}" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <UniformGrid x:Name="Cards" Grid.Row="3" Columns="3">
            <!-- Processor -->
            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                <StackPanel>
                    <DockPanel>
                        <Button x:Name="CpuButton" DockPanel.Dock="Right" Content="Run" VerticalAlignment="Top" Click="RunCpu_Click" />
                        <StackPanel>
                            <TextBlock Text="Processor" Style="{StaticResource CardTitle}" />
                            <TextBlock x:Name="CpuNote" FontSize="12" Style="{StaticResource Subtle}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="SingleScore" Style="{StaticResource BigValue}" Foreground="{StaticResource CpuBrush}" />
                            <TextBlock Text="Single-thread score" Style="{StaticResource StatLabel}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="MultiScore" Style="{StaticResource BigValue}" Foreground="{StaticResource CpuBrush}" />
                            <TextBlock x:Name="MultiLabel" Text="Multi-thread score" Style="{StaticResource StatLabel}" />
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="CpuTable" Margin="0,16,0,0" />
                </StackPanel>
            </Border>

            <!-- Memory -->
            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                <StackPanel>
                    <DockPanel>
                        <Button x:Name="MemButton" DockPanel.Dock="Right" Content="Run" VerticalAlignment="Top" Click="RunMemory_Click" />
                        <StackPanel>
                            <TextBlock Text="Memory" Style="{StaticResource CardTitle}" />
                            <TextBlock x:Name="MemNote" FontSize="12" Style="{StaticResource Subtle}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="MemRead" Style="{StaticResource BigValue}" Foreground="{StaticResource MemBrush}" />
                            <TextBlock Text="Read bandwidth" Style="{StaticResource StatLabel}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="MemLatency" Style="{StaticResource BigValue}" Foreground="{StaticResource MemBrush}" />
                            <TextBlock Text="Latency" Style="{StaticResource StatLabel}" />
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="MemTable" Margin="0,16,0,0" />
                </StackPanel>
            </Border>

            <!-- Drive -->
            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                <StackPanel>
                    <DockPanel>
                        <Button x:Name="DiskButton" DockPanel.Dock="Right" Content="Run" VerticalAlignment="Top" Click="RunDisk_Click" />
                        <StackPanel>
                            <TextBlock Text="Drive" Style="{StaticResource CardTitle}" />
                            <ComboBox x:Name="DriveBox" Margin="0,6,12,0" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </DockPanel>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="SeqRead" Style="{StaticResource BigValue}" Foreground="{StaticResource DiskBrush}" />
                            <TextBlock Text="Sequential read" Style="{StaticResource StatLabel}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="SeqWrite" Style="{StaticResource BigValue}" Foreground="{StaticResource DiskBrush}" />
                            <TextBlock Text="Sequential write" Style="{StaticResource StatLabel}" />
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="DiskTable" Margin="0,16,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="12,10" Margin="0,0,12,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="4,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Clear" Click="ClearHistory_Click" />
                    <TextBlock Text="Previous results" VerticalAlignment="Center" Style="{StaticResource CardTitle}" />
                </DockPanel>
                <DataGrid x:Name="HistoryList" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding TimeText}" SortMemberPath="Time" Width="160" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="Test" Binding="{Binding Test}" Width="110" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="Result" Binding="{Binding Summary}" Width="*" ElementStyle="{StaticResource CellText}" />
                    </DataGrid.Columns>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy" Click="CopyHistory_Click" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
