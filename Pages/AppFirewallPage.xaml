<UserControl x:Class="Tman.Pages.AppFirewallPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Tman.Controls">
    <UserControl.Resources>
        <DataTemplate x:Key="VerdictCell">
            <TextBlock Text="{Binding VerdictText}" Foreground="{Binding VerdictBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Padding="0,0,10,0" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
        <DataTemplate x:Key="AppCell">
            <DockPanel VerticalAlignment="Center">
                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="{Binding Name}" Style="{StaticResource CellText}" ToolTip="{Binding Path}" />
            </DockPanel>
        </DataTemplate>
        <Style x:Key="EnabledCell" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Enabled}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource SubtleBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RuleActionCell" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActionText}" Value="Block">
                    <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ActionText}" Value="Allow">
                    <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition MinHeight="160" />
        </Grid.RowDefinitions>
        <TextBlock Text="App firewall" Style="{StaticResource PageTitle}" />
        <TextBlock Grid.Row="1" Style="{StaticResource PageSubtitle}"
                   Text="Which apps talk to the network, the names they asked for, and rules that really block, per app or for the whole PC. Loopback, DHCP and your DNS servers always stay allowed unless a rule says otherwise." />
        <c:AdminNote Grid.Row="2" Text="Watching connections live and enforcing rules need administrator rights. Without them this page shows what's open right now, from the connection tables, and rules can be edited but not applied." />

        <Border Grid.Row="3" Style="{StaticResource SlimCard}" Margin="0,10,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button x:Name="AuditButton" Content="Turn on audit of blocks" Margin="0,0,8,0" Visibility="Collapsed" Click="Audit_Click"
                            ToolTip="Asks Windows to record each blocked connection in the Security log (auditpol, Filtering Platform Connection failures), which is where Blocked verdicts come from when the filter engine's own record can't be read." />
                    <Button x:Name="MonitorButton" Content="Start watching" Margin="0,0,8,0" Click="Monitor_Click" />
                    <Button x:Name="RemoveAllButton" Content="Remove all Tman filters" Click="RemoveAll_Click"
                            ToolTip="Deletes every filter Tman added to the Windows Filtering Platform and turns every rule off. The hosts file section is separate: see Blocklists." />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="StatusTitle" Style="{StaticResource CardHeading}" />
                    <TextBlock x:Name="StatusText" Style="{StaticResource Subtle}" Margin="0,3,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="4" Style="{StaticResource Toolbar}">
            <Button DockPanel.Dock="Right" Content="Refresh" Margin="8,0,0,0" Click="Refresh_Click" />
            <CheckBox x:Name="PromptBox" DockPanel.Dock="Right" Content="Prompt mode" Margin="12,0,0,0" VerticalAlignment="Center" Click="Prompt_Click"
                      ToolTip="Ask about each app the first time it connects and has no rule. Tman has no kernel driver, so that first connection goes through; your answer applies from then on. A prompt left alone allows." />
            <CheckBox x:Name="StartBox" DockPanel.Dock="Right" Content="Watch from startup" Margin="12,0,0,0" VerticalAlignment="Center" Click="Start_Click"
                      ToolTip="Start watching as soon as Tman starts as administrator, so history and prompts work from the tray." />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1000*" MinWidth="170" MaxWidth="320" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <c:SearchBox x:Name="Search" Placeholder="Search app, name, address or port" />
                <ComboBox x:Name="VerdictFilter" Grid.Column="1" Margin="10,0,0,0" MinWidth="130" SelectedIndex="0" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="Any verdict" />
                    <ComboBoxItem Content="Allowed" />
                    <ComboBoxItem Content="Blocked" />
                    <ComboBoxItem Content="Asked" />
                </ComboBox>
                <TextBlock x:Name="CountText" Grid.Column="2" Style="{StaticResource ToolbarCount}" />
            </Grid>
        </DockPanel>

        <TabControl x:Name="Tabs" Grid.Row="5" SelectionChanged="Tabs_SelectionChanged">
            <TabItem Header="Apps">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition MinHeight="60" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <WrapPanel Style="{StaticResource ActionRow}">
                        <Button x:Name="AllowAppButton" Content="Allow app" Margin="0,0,8,8" IsEnabled="False" Click="AllowApp_Click" ToolTip="A rule that lets this app through Tman's rules. It doesn't override Windows Firewall." />
                        <Button x:Name="BlockAppButton" Content="Block app" Margin="0,0,8,8" IsEnabled="False" Click="BlockApp_Click" ToolTip="A rule that blocks everything this app sends." />
                        <Button x:Name="BlockDestButton" Content="Block destination" Margin="0,0,8,8" IsEnabled="False" Click="BlockDest_Click" ToolTip="Blocks the selected name or address for this app." />
                        <Button x:Name="BlockDestAllButton" Content="Block for all apps" Margin="0,0,16,8" IsEnabled="False" Click="BlockDestAll_Click" ToolTip="Blocks the selected name or address for every app." />
                        <Button x:Name="RuleForButton" Content="New rule…" Margin="0,0,16,8" Click="NewRule_Click" />
                        <Button Content="Clear" Margin="0,0,8,8" Click="ClearLive_Click" ToolTip="Forgets what has been seen so far. Rules and history stay." />
                    </WrapPanel>
                    <DataGrid x:Name="AppsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="Apps_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="App" Width="200" MinWidth="160" SortMemberPath="Name" CellTemplate="{StaticResource AppCell}" />
                            <DataGridTemplateColumn Header="Verdict" Width="120" MinWidth="110" SortMemberPath="VerdictText" CellTemplate="{StaticResource VerdictCell}" />
                            <DataGridTextColumn Header="Connections" Binding="{Binding Connections}" Width="100" MinWidth="100" ElementStyle="{StaticResource NumText}" />
                            <DataGridTextColumn Header="Blocked" Binding="{Binding BlockedText}" SortMemberPath="Blocked" Width="80" MinWidth="80" ElementStyle="{StaticResource NumText}" />
                            <DataGridTextColumn Header="Sent" Binding="{Binding SentText}" SortMemberPath="Sent" Width="85" MinWidth="85" ElementStyle="{StaticResource NumText}" />
                            <DataGridTextColumn Header="Received" Binding="{Binding ReceivedText}" SortMemberPath="Received" Width="85" MinWidth="85" ElementStyle="{StaticResource NumText}" />
                            <DataGridTextColumn Header="Destinations" Binding="{Binding DestinationsText}" Width="*" MinWidth="200" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Last seen" Binding="{Binding LastText}" SortMemberPath="Last" Width="100" MinWidth="100" ElementStyle="{StaticResource CellText}" />
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Allow app" Click="AllowApp_Click" />
                                <MenuItem Header="Block app" Click="BlockApp_Click" />
                                <Separator />
                                <MenuItem Header="Open file location" Click="OpenLocation_Click" />
                                <MenuItem Header="Copy path" Click="CopyPath_Click" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                    <TextBlock x:Name="AppsEmpty" Grid.Row="1" Style="{StaticResource EmptyText}" Visibility="Collapsed" />
                    <TextBlock x:Name="DestTitle" Grid.Row="2" Style="{StaticResource CardTitle}" Margin="0,12,0,6" Visibility="Collapsed" />
                    <DataGrid x:Name="DestGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" MaxHeight="220" Visibility="Collapsed" SelectionChanged="Dest_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Host}" Width="*" MinWidth="200" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Address" Binding="{Binding Ip}" Width="170" MinWidth="130" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="60" MinWidth="60" ElementStyle="{StaticResource NumText}" />
                            <DataGridTextColumn Header="Protocol" Binding="{Binding ProtocolText}" Width="90" MinWidth="90" ElementStyle="{StaticResource CellText}" />
                            <DataGridTemplateColumn Header="Verdict" Width="110" MinWidth="100" SortMemberPath="VerdictText" CellTemplate="{StaticResource VerdictCell}" />
                            <DataGridTextColumn Header="Rule" Binding="{Binding Rule}" Width="*" MinWidth="120" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="60" MinWidth="60" ElementStyle="{StaticResource NumText}" />
                            <DataGridTextColumn Header="Sent" Binding="{Binding SentText}" SortMemberPath="Sent" Width="80" MinWidth="80" ElementStyle="{StaticResource NumText}" />
                            <DataGridTextColumn Header="Received" Binding="{Binding ReceivedText}" SortMemberPath="Received" Width="80" MinWidth="80" ElementStyle="{StaticResource NumText}" />
                            <DataGridTextColumn Header="Last" Binding="{Binding LastText}" SortMemberPath="Last" Width="100" MinWidth="100" ElementStyle="{StaticResource CellText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Rules">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition MinHeight="60" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <WrapPanel Style="{StaticResource ActionRow}">
                        <Button Content="Add…" Margin="0,0,8,8" Click="NewRule_Click" />
                        <Button x:Name="EditRuleButton" Content="Edit…" Margin="0,0,8,8" IsEnabled="False" Click="EditRule_Click" />
                        <Button x:Name="RemoveRuleButton" Content="Remove" Margin="0,0,16,8" IsEnabled="False" Click="RemoveRule_Click" />
                        <Button x:Name="EnableRuleButton" Content="Enable" Margin="0,0,8,8" IsEnabled="False" Click="EnableRule_Click" />
                        <Button x:Name="DisableRuleButton" Content="Disable" Margin="0,0,16,8" IsEnabled="False" Click="DisableRule_Click" />
                        <Button Content="Show filters" Margin="0,0,8,8" Click="ShowFilters_Click" ToolTip="Lists what Tman has in the Windows Filtering Platform right now, to compare with netsh wfp show filters." />
                        <TextBlock x:Name="RulesCount" Style="{StaticResource ToolbarCount}" Margin="4,0,0,8" />
                    </WrapPanel>
                    <DataGrid x:Name="RulesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionChanged="Rules_SelectionChanged" MouseDoubleClick="Rules_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="App" Binding="{Binding AppName}" Width="180" MinWidth="140" ElementStyle="{StaticResource EnabledCell}" />
                            <DataGridTextColumn Header="Action" Binding="{Binding ActionText}" Width="70" MinWidth="70" ElementStyle="{StaticResource RuleActionCell}" />
                            <DataGridTextColumn Header="Direction" Binding="{Binding DirectionText}" Width="90" MinWidth="90" ElementStyle="{StaticResource EnabledCell}" />
                            <DataGridTextColumn Header="Target" Binding="{Binding TargetText}" Width="*" MinWidth="200" ElementStyle="{StaticResource EnabledCell}" />
                            <DataGridTextColumn Header="Enabled" Binding="{Binding EnabledText}" Width="74" MinWidth="74" ElementStyle="{StaticResource EnabledCell}" />
                            <DataGridTextColumn Header="Blocked" Binding="{Binding Hits}" Width="80" MinWidth="80" ElementStyle="{StaticResource NumText}" />
                            <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*" MinWidth="120" ElementStyle="{StaticResource EnabledCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="RulesEmpty" Grid.Row="1" Style="{StaticResource EmptyText}" Visibility="Collapsed" />
                    <TextBlock x:Name="RulesNote" Grid.Row="2" Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="Rules become filters in the Windows Filtering Platform, under Tman's own provider, and persist, so they hold while Tman is closed. A block here beats any Windows Firewall allow; an allow here never overrides a Windows Firewall block. Domain rules work from the names apps ask for while Tman is watching, so they apply only while it runs; the hosts file blocklist covers names PC-wide." />
                </Grid>
            </TabItem>
            <TabItem Header="Blocklists">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition MinHeight="60" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource SlimCard}" Margin="0,0,0,10">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Button x:Name="HostsApplyButton" Content="Write to hosts file" Margin="0,0,8,0" Click="HostsApply_Click" />
                                <Button x:Name="HostsRemoveButton" Content="Remove from hosts file" Click="HostsRemove_Click" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="HostsTitle" Style="{StaticResource CardHeading}" />
                                <TextBlock x:Name="HostsText" Style="{StaticResource Subtle}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <WrapPanel Grid.Row="1" Style="{StaticResource ActionRow}">
                        <Button Content="Edit lists…" Margin="0,0,8,8" Click="EditLists_Click" />
                        <Button x:Name="ListToggleButton" Content="Turn off" Margin="0,0,16,8" IsEnabled="False" Click="ListToggle_Click" />
                        <Button x:Name="UpdateListsButton" Content="Update now" Margin="0,0,16,8" Click="UpdateLists_Click" ToolTip="Downloads each list again. Otherwise lists are refreshed weekly." />
                        <TextBox x:Name="CheckNameBox" Width="220" Margin="0,0,8,8" VerticalContentAlignment="Center" KeyDown="CheckBox_KeyDown" ToolTip="A name to look up in the lists" AutomationProperties.Name="Name to check" />
                        <Button Content="Check name" Margin="0,0,8,8" Click="CheckName_Click" />
                        <TextBlock x:Name="CheckResult" Style="{StaticResource ToolbarCount}" Margin="4,0,0,8" />
                    </WrapPanel>
                    <DataGrid x:Name="ListsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="Lists_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="List" Binding="{Binding Name}" Width="200" MinWidth="160" ElementStyle="{StaticResource EnabledCell}" />
                            <DataGridTextColumn Header="In use" Binding="{Binding EnabledText}" Width="70" MinWidth="70" ElementStyle="{StaticResource EnabledCell}" />
                            <DataGridTextColumn Header="Names" Binding="{Binding DomainsText}" SortMemberPath="Domains" Width="90" MinWidth="90" ElementStyle="{StaticResource NumText}" />
                            <DataGridTextColumn Header="Downloaded" Binding="{Binding SavedText}" SortMemberPath="Saved" Width="110" MinWidth="110" ElementStyle="{StaticResource EnabledCell}" />
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="*" MinWidth="150" ElementStyle="{StaticResource EnabledCell}" />
                            <DataGridTextColumn Header="Address" Binding="{Binding Url}" Width="*" MinWidth="200" ElementStyle="{StaticResource EnabledCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="3" Margin="0,8,0,0">
                        <CheckBox x:Name="LiveBlockBox" Content="While Tman is watching, also block the addresses that listed names resolve to" Click="LiveBlock_Click"
                                  ToolTip="Catches subdomains the hosts file can't (it has no wildcards). Shared addresses, such as a CDN's, would be blocked for everything on them, so this is off unless you turn it on. It lasts for the session only." />
                        <TextBlock x:Name="ListsNote" Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Why the hosts file: a resolver inside Tman would leave the PC without DNS whenever Tman isn't running, and Tman has no service. Names in the hosts file resolve to 0.0.0.0 whether Tman runs or not, and a dated backup is made before each write. The trade-off: no wildcards, Windows reads a long file a little more slowly, and names Windows itself needs (Microsoft, Windows Update, Office, Xbox) are kept out so Defender doesn't treat the section as a hijack and so updates keep working." />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="History">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition MinHeight="60" />
                    </Grid.RowDefinitions>
                    <UniformGrid Rows="1" Margin="0,0,-12,10">
                        <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="Allowed" Style="{StaticResource StatLabel}" />
                                <TextBlock x:Name="AllowedCount" Text="—" Style="{StaticResource StatBig}" Foreground="{StaticResource GoodBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="Blocked" Style="{StaticResource StatLabel}" />
                                <TextBlock x:Name="BlockedCount" Text="—" Style="{StaticResource StatBig}" Foreground="{StaticResource BadBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="Asked" Style="{StaticResource StatLabel}" />
                                <TextBlock x:Name="AskedCount" Text="—" Style="{StaticResource StatBig}" Foreground="{StaticResource WarnBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="Apps seen" Style="{StaticResource StatLabel}" />
                                <TextBlock x:Name="AppsCount" Text="—" Style="{StaticResource StatBig}" Foreground="{StaticResource AccentBrush}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <WrapPanel Grid.Row="1" Style="{StaticResource ActionRow}">
                        <TextBlock Text="Keep" VerticalAlignment="Center" Margin="0,0,8,8" />
                        <ComboBox x:Name="KeepBox" MinWidth="110" Margin="0,0,16,8" SelectionChanged="Keep_Changed">
                            <ComboBoxItem Content="1 day" Tag="1" />
                            <ComboBoxItem Content="7 days" Tag="7" />
                            <ComboBoxItem Content="30 days" Tag="30" />
                            <ComboBoxItem Content="90 days" Tag="90" />
                        </ComboBox>
                        <Button Content="Export CSV" Margin="0,0,8,8" Click="Export_Click" />
                        <Button Content="Clear history" Margin="0,0,8,8" Click="ClearHistory_Click" />
                        <TextBlock x:Name="HistoryCount" Style="{StaticResource ToolbarCount}" Margin="4,0,0,8" />
                    </WrapPanel>
                    <DataGrid x:Name="HistoryGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" SortMemberPath="Time" Width="130" MinWidth="130" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="App" Binding="{Binding App}" Width="150" MinWidth="120" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="*" MinWidth="180" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Address" Binding="{Binding Ip}" Width="150" MinWidth="120" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Port" Binding="{Binding PortText}" SortMemberPath="Port" Width="60" MinWidth="60" ElementStyle="{StaticResource NumText}" />
                            <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="90" MinWidth="90" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Dir" Binding="{Binding DirectionText}" Width="50" MinWidth="50" ElementStyle="{StaticResource CellText}" />
                            <DataGridTemplateColumn Header="Verdict" Width="90" MinWidth="90" SortMemberPath="Verdict" CellTemplate="{StaticResource VerdictCell}" />
                            <DataGridTextColumn Header="Rule" Binding="{Binding Rule}" Width="*" MinWidth="140" ElementStyle="{StaticResource CellText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="HistoryEmpty" Grid.Row="2" Style="{StaticResource EmptyText}" Visibility="Collapsed" />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
