<UserControl x:Class="Tman.Pages.EnvironmentPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Tman.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition MinHeight="80" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="Environment" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="CountText" Margin="12,0,0,3" VerticalAlignment="Bottom" TextAlignment="Right" TextTrimming="CharacterEllipsis" Style="{StaticResource Subtle}" />
        </DockPanel>
        <c:AdminNote Grid.Row="1" Margin="0,10,0,0"
                     Text="Changing system variables needs administrator rights. You can view them, and your own user variables work as normal." />
        <c:SearchBox x:Name="Search" Grid.Row="2" MaxWidth="300" HorizontalAlignment="Left" Width="300" Margin="0,12,0,6" Placeholder="Search names and values" />
        <WrapPanel Grid.Row="3" Margin="0,2,0,4">
            <Button Content="Add" Margin="0,0,8,6" Click="Add_Click" />
            <Button x:Name="EditButton" Content="Edit" Margin="0,0,8,6" IsEnabled="False" Click="Edit_Click" />
            <Button x:Name="DeleteButton" Content="Delete" Margin="0,0,8,6" IsEnabled="False" Click="Delete_Click" />
            <Button Content="User PATH" Margin="0,0,8,6" Click="UserPath_Click" />
            <Button Content="System PATH" Margin="0,0,8,6" Click="SystemPath_Click" />
            <Button Content="Backups" Margin="0,0,8,6" Click="Backups_Click" />
            <Button Content="Refresh" Margin="0,0,8,6" Click="Refresh_Click" />
        </WrapPanel>
        <DataGrid x:Name="List" Grid.Row="4" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  SelectionChanged="List_SelectionChanged" MouseDoubleClick="List_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Scope" Binding="{Binding ScopeText}" Width="75" MinWidth="75" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200" MinWidth="200" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" MinWidth="260" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Type" Binding="{Binding KindText}" Width="95" MinWidth="95" ElementStyle="{StaticResource CellText}" />
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="EditMenu" Header="Edit" Click="Edit_Click" />
                    <MenuItem x:Name="DeleteMenu" Header="Delete" Click="Delete_Click" />
                    <Separator />
                    <MenuItem Header="Copy value" Click="CopyValue_Click" />
                    <MenuItem Header="Copy name" Click="CopyName_Click" />
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
        <TextBlock x:Name="EmptyText" Grid.Row="4" Style="{StaticResource Subtle}" TextWrapping="Wrap" TextAlignment="Center" Margin="30,40,30,0"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" />
        <Border x:Name="DetailsPane" Grid.Row="5" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="14,10" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="DetailTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DetailValue" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Border>
        <TextBlock x:Name="StatusText" Grid.Row="6" Style="{StaticResource Subtle}" Margin="0,8,0,0" TextWrapping="Wrap"
                   Text="Running apps keep the values they started with, so restart an app to see a change." />
    </Grid>
</UserControl>
