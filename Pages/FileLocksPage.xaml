<UserControl x:Class="Tman.Pages.FileLocksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Tman.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <TextBlock Text="File locks" Style="{StaticResource PageTitle}" />
        <TextBlock Grid.Row="1" Margin="0,2,0,0" TextWrapping="Wrap" Style="{StaticResource Subtle}"
                   Text="Find which programs have a file or folder open, the usual cause of &quot;file in use&quot; errors. Type part of a path or a file name." />

        <DockPanel Grid.Row="2" Margin="0,12,0,8">
            <Button DockPanel.Dock="Right" Content="Pick folder…" Margin="8,0,0,0" Click="PickFolder_Click" />
            <Button DockPanel.Dock="Right" Content="Pick file…" Click="PickFile_Click" />
            <c:SearchBox x:Name="Query" Width="440" Placeholder="Path or name, e.g. report.xlsx or C:\Projects\site" />
            <Button x:Name="SearchButton" Margin="8,0,0,0" Click="Search_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,8,0" />
                    <TextBlock Text="Search" />
                </StackPanel>
            </Button>
            <Button x:Name="CancelButton" Content="Cancel" Margin="8,0,0,0" Visibility="Collapsed" Click="Cancel_Click" />
            <CheckBox x:Name="IncludeDlls" Content="Include loaded DLLs" IsChecked="True" Margin="14,0,0,0" />
        </DockPanel>

        <Border x:Name="AdminNote" Grid.Row="3" Style="{StaticResource Card}" Padding="14,8" Margin="0,0,0,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Restart as administrator" Click="Admin_Click" />
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}"
                           Text="Running as a standard user, so only your own processes can be searched. Files held by services or other users won't show up." />
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,8">
            <ProgressBar x:Name="Busy" Width="120" Height="4" IsIndeterminate="True" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" Style="{StaticResource Subtle}" TextWrapping="Wrap" />
        </StackPanel>

        <DataGrid x:Name="Results" Grid.Row="5" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Process" SortMemberPath="Process" Width="220">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <DockPanel VerticalAlignment="Center">
                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="{Binding Process}" Style="{StaticResource CellText}" />
                            </DockPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70" ElementStyle="{StaticResource NumText}" />
                <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="80" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" ElementStyle="{StaticResource CellText}" />
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="End process…" Click="EndProcess_Click" />
                    <Separator />
                    <MenuItem Header="Open file location" Click="OpenLocation_Click" />
                    <MenuItem Header="Copy path" Click="CopyPath_Click" />
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
    </Grid>
</UserControl>
