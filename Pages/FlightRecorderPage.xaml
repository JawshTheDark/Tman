<UserControl x:Class="Tman.Pages.FlightRecorderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Tman.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition MinHeight="200" />
        </Grid.RowDefinitions>

        <TextBlock Text="Flight recorder" Style="{StaticResource PageTitle}" />
        <TextBlock Grid.Row="1" Margin="0,2,0,0" TextWrapping="Wrap" Style="{StaticResource Subtle}"
                   Text="Tman keeps the last hour of activity in memory. Click or drag on the timeline to see what was running at that moment." />

        <DockPanel Grid.Row="2" Margin="0,12,0,10">
            <Button DockPanel.Dock="Right" Content="Export CSV…" Margin="8,0,0,0" Click="Export_Click" />
            <Button x:Name="LiveButton" DockPanel.Dock="Right" Visibility="Collapsed" Click="Live_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE768;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,8,0" />
                    <TextBlock Text="Back to live" />
                </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Show" VerticalAlignment="Center" Margin="0,0,12,0" Style="{StaticResource Subtle}" />
                <RadioButton Content="5 min" GroupName="Range" Tag="5" IsChecked="True" MinWidth="0" Margin="0,0,14,0" Click="Range_Click" />
                <RadioButton Content="15 min" GroupName="Range" Tag="15" MinWidth="0" Margin="0,0,14,0" Click="Range_Click" />
                <RadioButton Content="60 min" GroupName="Range" Tag="60" MinWidth="0" Click="Range_Click" />
            </StackPanel>
            <TextBlock x:Name="StatusText" Margin="20,0,0,0" VerticalAlignment="Center" Style="{StaticResource Subtle}" />
        </DockPanel>

        <c:NeonPanel x:Name="TimelinePanel" Grid.Row="3" Header="Timeline" Padding="12,10,12,12" Margin="0,0,0,14">
            <c:Timeline x:Name="Chart" />
        </c:NeonPanel>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="12" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="12,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="4,0,0,8">
                        <TextBlock x:Name="MomentTitle" Text="Now" Style="{StaticResource CardTitle}" />
                        <TextBlock x:Name="MomentStats" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Style="{StaticResource Subtle}" />
                    </StackPanel>
                    <DataGrid x:Name="MomentList" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Process" SortMemberPath="Name" Width="*" MinWidth="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DockPanel VerticalAlignment="Center" ToolTip="{Binding Description}">
                                            <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource CellText}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="CPU" Binding="{Binding CpuText}" SortMemberPath="Cpu" Width="70" ElementStyle="{StaticResource NumText}" />
                            <DataGridTextColumn Header="Memory" Binding="{Binding MemoryText}" SortMemberPath="Memory" Width="100" ElementStyle="{StaticResource NumText}" />
                            <DataGridTextColumn Header="Disk" Binding="{Binding IoText}" SortMemberPath="Io" Width="85" ElementStyle="{StaticResource NumText}" />
                            <DataGridTextColumn Header="GPU" Binding="{Binding GpuText}" SortMemberPath="Gpu" Width="60" ElementStyle="{StaticResource NumText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12,10">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="4,0,0,8">
                        <ComboBox x:Name="EventFilter" DockPanel.Dock="Right" MinWidth="150" SelectedIndex="0" VerticalAlignment="Center"
                                  SelectionChanged="EventFilter_SelectionChanged">
                            <ComboBoxItem Content="All events" />
                            <ComboBoxItem Content="Spikes" />
                            <ComboBoxItem Content="Process starts" />
                            <ComboBoxItem Content="Process exits" />
                        </ComboBox>
                        <StackPanel>
                            <TextBlock Text="Events" Style="{StaticResource CardTitle}" />
                            <TextBlock x:Name="EventCount" FontSize="12" Margin="0,2,0,0" Style="{StaticResource Subtle}" />
                        </StackPanel>
                    </DockPanel>
                    <DataGrid x:Name="EventList" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              SelectionChanged="EventList_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" SortMemberPath="Time" Width="124" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Event" Binding="{Binding KindText}" Width="95" ElementStyle="{StaticResource CellText}" />
                            <DataGridTemplateColumn Header="What" SortMemberPath="Title" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DockPanel VerticalAlignment="Center">
                                            <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource CellText}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Details" SortMemberPath="Detail" Width="*" MinWidth="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Detail}" ToolTip="{Binding Detail}" Style="{StaticResource CellText}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copy" Click="CopyEvent_Click" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
