<UserControl x:Class="Tman.Pages.FirewallPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Tman.Controls">
    <UserControl.Resources>
        <Style x:Key="ActionCell" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Allow}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EnabledCell" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Enabled}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource SubtleBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ProfileState" TargetType="TextBlock" BasedOn="{StaticResource StatBig}">
            <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Enabled}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition MinHeight="90" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Firewall" Style="{StaticResource PageTitle}" />
        <c:AdminNote Grid.Row="1" Text="Changing a rule or turning the firewall on or off needs administrator rights." />
        <ItemsControl x:Name="Profiles" Grid.Row="2" Margin="0,12,-12,0" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,12,0" ToolTip="{Binding DefaultsHint}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{Binding ToggleText}" Tag="{Binding}" Margin="8,0,0,0" VerticalAlignment="Center" Click="ProfileToggle_Click" />
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource StatLabel}" />
                                    <TextBlock Text="{Binding ActiveText}" Style="{StaticResource StatLabel}" Foreground="{StaticResource AccentBrush}" Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding StateText}" Style="{StaticResource ProfileState}" />
                                <TextBlock Text="{Binding DefaultsText}" FontSize="12" Style="{StaticResource Subtle}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Grid Grid.Row="3" Style="{StaticResource Toolbar}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1000*" MinWidth="170" MaxWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <c:SearchBox x:Name="Search" Placeholder="Search name, program, port or group" />
            <ComboBox x:Name="DirectionFilter" Grid.Column="1" Margin="10,0,0,0" MinWidth="120" SelectedIndex="0" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Any direction" />
                <ComboBoxItem Content="Inbound" />
                <ComboBoxItem Content="Outbound" />
            </ComboBox>
            <ComboBox x:Name="ActionFilter" Grid.Column="2" Margin="10,0,0,0" MinWidth="110" SelectedIndex="0" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Any action" />
                <ComboBoxItem Content="Allow" />
                <ComboBoxItem Content="Block" />
            </ComboBox>
            <ComboBox x:Name="EnabledFilter" Grid.Column="3" Margin="10,0,0,0" MinWidth="110" SelectedIndex="0" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Any state" />
                <ComboBoxItem Content="Enabled" />
                <ComboBoxItem Content="Disabled" />
            </ComboBox>
            <CheckBox x:Name="NonMicrosoft" Grid.Column="4" Content="Non-Microsoft rules" Margin="14,0,0,0" VerticalAlignment="Center" Click="Filter_Changed" />
            <TextBlock x:Name="CountText" Grid.Column="5" Style="{StaticResource ToolbarCount}" />
            <Button Grid.Column="7" Content="Refresh" Margin="8,0,0,0" Click="Refresh_Click" />
        </Grid>
        <WrapPanel Grid.Row="4" Style="{StaticResource ActionRow}">
            <Button x:Name="EnableButton" Content="Enable" Margin="0,0,8,8" IsEnabled="False" Click="Enable_Click" />
            <Button x:Name="DisableButton" Content="Disable" Margin="0,0,8,8" IsEnabled="False" Click="Disable_Click" />
            <Button x:Name="DeleteButton" Content="Delete" Margin="0,0,16,8" IsEnabled="False" Click="Delete_Click" />
            <Button Content="Open Windows Defender Firewall" Margin="0,0,8,8" Click="OpenFirewall_Click" />
        </WrapPanel>
        <DataGrid x:Name="List" Grid.Row="5" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionChanged="List_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="220" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Direction" Binding="{Binding DirectionText}" Width="84" MinWidth="84" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Action" Binding="{Binding ActionText}" Width="66" MinWidth="66" ElementStyle="{StaticResource ActionCell}" />
                <DataGridTextColumn Header="Enabled" Binding="{Binding EnabledText}" Width="74" MinWidth="74" ElementStyle="{StaticResource EnabledCell}" />
                <DataGridTextColumn Header="Profile" Binding="{Binding Profiles}" Width="100" MinWidth="100" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Program" Binding="{Binding ProgramName}" Width="150" MinWidth="130" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Ports" Binding="{Binding Ports}" Width="110" MinWidth="100" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="170" MinWidth="130" ElementStyle="{StaticResource CellText}" />
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Enable" Click="Enable_Click" />
                    <MenuItem Header="Disable" Click="Disable_Click" />
                    <MenuItem Header="Delete" Click="Delete_Click" />
                    <Separator />
                    <MenuItem Header="Open file location" Click="OpenLocation_Click" />
                    <MenuItem Header="Copy name" Click="CopyName_Click" />
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
        <TextBlock x:Name="EmptyText" Grid.Row="5" Style="{StaticResource EmptyText}" Visibility="Collapsed" />
        <Border x:Name="DetailsPane" Grid.Row="6" Style="{StaticResource SlimCard}" Margin="0,10,0,0" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="DetailTitle" Style="{StaticResource CardHeading}" />
                <TextBlock x:Name="DetailDesc" Style="{StaticResource Subtle}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="DetailProgram" Style="{StaticResource Subtle}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
