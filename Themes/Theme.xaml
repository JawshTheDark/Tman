<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Tahoma everywhere. Fluent's control styles read the system font keys, so overriding them here
         also covers popups (menus, tooltips, dropdowns) that don't inherit from the window. -->
    <FontFamily x:Key="UiFont">Tahoma</FontFamily>
    <FontFamily x:Key="{x:Static SystemFonts.MessageFontFamilyKey}">Tahoma</FontFamily>
    <FontFamily x:Key="{x:Static SystemFonts.MenuFontFamilyKey}">Tahoma</FontFamily>
    <FontFamily x:Key="{x:Static SystemFonts.StatusFontFamilyKey}">Tahoma</FontFamily>
    <FontFamily x:Key="{x:Static SystemFonts.CaptionFontFamilyKey}">Tahoma</FontFamily>
    <FontFamily x:Key="{x:Static SystemFonts.SmallCaptionFontFamilyKey}">Tahoma</FontFamily>
    <FontFamily x:Key="{x:Static SystemFonts.IconFontFamilyKey}">Tahoma</FontFamily>

    <!-- Instrument colors: one per device, used by meters, gauges and graphs everywhere -->
    <Color x:Key="CpuColor">#33B5FF</Color>
    <Color x:Key="MemColor">#B87CFF</Color>
    <Color x:Key="DiskColor">#3DDC84</Color>
    <Color x:Key="NetColor">#FFAD33</Color>
    <Color x:Key="GpuColor">#FF5C8A</Color>
    <Color x:Key="PowerColor">#FFD34D</Color>
    <Color x:Key="AccentColor">#3FC8FF</Color>
    <SolidColorBrush x:Key="CpuBrush" Color="{StaticResource CpuColor}" />
    <SolidColorBrush x:Key="MemBrush" Color="{StaticResource MemColor}" />
    <SolidColorBrush x:Key="DiskBrush" Color="{StaticResource DiskColor}" />
    <SolidColorBrush x:Key="NetBrush" Color="{StaticResource NetColor}" />
    <SolidColorBrush x:Key="GpuBrush" Color="{StaticResource GpuColor}" />
    <SolidColorBrush x:Key="PowerBrush" Color="{StaticResource PowerColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />

    <!-- Surfaces: near-black chassis, slightly lifted panels -->
    <SolidColorBrush x:Key="WindowBrush" Color="#0A0C0F" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#0D1014" />
    <SolidColorBrush x:Key="ContentBrush" Color="#0A0C0F" />
    <SolidColorBrush x:Key="CardBrush" Color="#12151A" />
    <SolidColorBrush x:Key="CardStrokeBrush" Color="#232A33" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#8C96A3" />
    <SolidColorBrush x:Key="LabelBrush" Color="#7FA8C4" />
    <SolidColorBrush x:Key="TitleBrush" Color="#F2F5F8" />
    <SolidColorBrush x:Key="NavHoverBrush" Color="#121A22" />
    <LinearGradientBrush x:Key="NavSelectedBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#403FC8FF" Offset="0" />
        <GradientStop Color="#123FC8FF" Offset="0.7" />
        <GradientStop Color="#003FC8FF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GoodBrush" Color="#3DDC84" />
    <SolidColorBrush x:Key="WarnBrush" Color="#FFD34D" />
    <SolidColorBrush x:Key="BadBrush" Color="#FF6B6B" />

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#F2F5F8" />
    </Style>
    <Style x:Key="Subtle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource SubtleBrush}" />
    </Style>

    <!-- Page layout. Every page stacks the same way: title, one line about the page, the admin note, a toolbar, then
         content. Each block brings its own space above it, so nothing shifts when the admin note is hidden. -->
    <Style x:Key="PageSubtitle" TargetType="TextBlock" BasedOn="{StaticResource Subtle}">
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- The row of search, filters and actions under the title. Search comes first, actions sit on the right, Refresh last. -->
    <Style x:Key="Toolbar" TargetType="FrameworkElement">
        <Setter Property="Margin" Value="0,12,0,10" />
    </Style>
    <!-- "310 services · 120 running", after the filters -->
    <Style x:Key="ToolbarCount" TargetType="TextBlock" BasedOn="{StaticResource Subtle}">
        <Setter Property="Margin" Value="16,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- Buttons for the selected row, directly above the list they act on -->
    <Style x:Key="ActionRow" TargetType="FrameworkElement">
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <!-- First block of content on a page with no toolbar -->
    <Style x:Key="PageBody" TargetType="FrameworkElement">
        <Setter Property="Margin" Value="0,12,0,0" />
    </Style>
    <!-- What a list says when it has nothing to show -->
    <Style x:Key="EmptyText" TargetType="TextBlock" BasedOn="{StaticResource Subtle}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="30,50,30,0" />
    </Style>
    <!-- The bright first line of a card, above a Subtle line of detail -->
    <Style x:Key="CardHeading" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TitleBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- The large figure on a stat tile, under a StatLabel -->
    <Style x:Key="StatBig" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource LabelBrush}" />
    </Style>
    <!-- Small all-caps instrument label; callers pass upper-case text -->
    <Style x:Key="PanelLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource LabelBrush}" />
    </Style>
    <Style x:Key="StatLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource SubtleBrush}" />
    </Style>
    <Style x:Key="StatValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="NumText" TargetType="TextBlock">
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="Padding" Value="0,0,10,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="CellText" TargetType="TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Padding" Value="0,0,10,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <!-- A card holding a line or two: status strips, detail panes, list rows -->
    <Style x:Key="SlimCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="14,10" />
    </Style>

    <!-- Sidebar navigation item -->
    <Style x:Key="NavItem" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="#C9D1DA" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Margin="8,1" Height="36" CornerRadius="3" Background="Transparent">
                        <Grid>
                            <Border x:Name="Pill" Width="3" CornerRadius="1.5" HorizontalAlignment="Left" Margin="0,7"
                                    Background="{StaticResource AccentBrush}" Visibility="Collapsed">
                                <Border.Effect>
                                    <DropShadowEffect Color="{StaticResource AccentColor}" BlurRadius="8" ShadowDepth="0" Opacity="0.9" />
                                </Border.Effect>
                            </Border>
                            <ContentPresenter Margin="14,0,8,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavSelectedBrush}" />
                            <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="#FFFFFF" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NavHeader" TargetType="ListBoxItem">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Margin="18,12,12,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center" />
                        <Border Grid.Column="1" Height="1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#663FC8FF" Offset="0" />
                                    <GradientStop Color="#003FC8FF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Performance page device list item -->
    <Style x:Key="DeviceItem" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Margin="0,2" Padding="8" CornerRadius="4" Background="Transparent"
                            BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavSelectedBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#553FC8FF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
